---
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../assets/sticky-whatsapp.svg';
import contact from '../config/contact';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

const siteUrl = 'https://herniacenter.ro';
const description = 'Hernia Center - chirurgie minim invazivă a herniilor - Cluj-Napoca';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="hernie, chirurgie hernie, hernie inghinală, hernie ombilicală, hernie incizională, laparoscopie, chirurgie minim invazivă, Cluj-Napoca, Dr. Trif"
    />
    <meta name="author" content="Dr. Trif - Hernia Center" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo tags -->
    <meta name="geo.region" content="RO-CJ" />
    <meta name="geo.placename" content="Cluj-Napoca" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="Hernia Center" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og.png`} />

    <!-- Structured Data / JSON-LD -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MedicalClinic',
        name: 'Hernia Center',
        description: description,
        url: siteUrl,
        image: `${siteUrl}/og.png`,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Cluj-Napoca',
          addressRegion: 'Cluj',
          addressCountry: 'RO',
        },
        medicalSpecialty: 'Chirurgie generală',
        availableService: {
          '@type': 'MedicalProcedure',
          name: 'Chirurgie minim invazivă a herniilor',
          procedureType: 'Laparoscopic',
        },
      })}
    />

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Fixed WhatsApp button -->
    <div class="fixed right-6 bottom-6 z-50 md:right-18">
      <a
        href={contact.whatsapp}
        class="block transition-transform hover:scale-105"
        aria-label="Contact WhatsApp"
      >
        <StickyWhatsApp class="h-12 w-12 md:h-16 md:w-16" />
      </a>
    </div>
    <SpeedInsights />
  </body>
</html>
