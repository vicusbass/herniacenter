---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital.png';
import hospital1 from '../assets/spital/hospital1.png';
import device from '../assets/despre/device.png';
import LottieAnimation from 'astro-integration-lottie/Lottie.astro';

const carouselItems = [
  {
    image: hospital1,
    description:
      'Utilizăm cele mai moderne tehnici chirurgicale mini-invazive pentru tratamentul herniilor, garantând o recuperare rapidă și rezultate excelente.',
  },
  {
    image: device,
    description:
      'Pacientul beneficiază de evaluare, intervenție chirurgicală minim invazivă și monitorizare postoperatorie, toate în același loc.',
  },
  {
    image: spital,
    description:
      'Am creat un traseu medical complet, într-un spațiu modern, sigur și bine organizat.',
  },
];
---

<Layout title="Hernia Center - Spitalul">
  <div class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="block md:hidden">
          <div class="px-4">
            <h1 class="text-5xl leading-none font-bold tracking-tight">spitalul</h1>
          </div>
          <div class="w-full pt-8">
            <Image src={spital} alt="Spital" class="w-full object-cover" />
          </div>
        </div>

        <div class="relative hidden md:flex">
          <!-- Desktop: Show h1 in grid cell -->
          <div
            class="border-custom flex aspect-square w-[12.5vw] items-end border-b border-l px-0 py-0"
          >
            <h1
              class="leading-none font-bold tracking-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.5rem); transform: translateY(clamp(8px, 0.5vw, 12px));"
            >
              spitalul
            </h1>
          </div>
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
          <!-- Hospital image - spanning cells on desktop -->
          <div
            id="hospital-image"
            class="absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%] transition-all duration-300"
          >
            <Image src={spital} alt="Spital" class="h-full w-full object-cover" />
          </div>
        </div>

        <!-- Row 2 - Hidden on mobile -->
        <div class="hidden md:flex">
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
        </div>
        <div class="pt-4 pl-4 text-left sm:pt-16">
          <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
            >01.</span
          >
          <div class="w-full sm:w-3/5">
            <h2
              class="leading-none font-bold tracking-normal"
              style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
            >
              Hernia Center - tratament modern al herniilor, în cadrul Spitalului Medicover Cluj
            </h2>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden md:block md:w-[12.5%]"></div>
  </div>
  
  <div id="carousel-1" class="relative w-full pt-18 overflow-hidden">
    <!-- Carousel Container -->
    <div class="carousel-container relative overflow-hidden">
      <div class="carousel-track flex transition-transform duration-500 ease-in-out overflow-x-auto md:overflow-visible scroll-smooth snap-x snap-mandatory md:snap-none">
        {carouselItems.map((item, index) => (
          <div class="carousel-slide flex h-[60vh] w-full flex-shrink-0 flex-col md:flex-row snap-start">

            <!-- Image Section - Top on mobile, Right two-thirds on desktop -->
            <div class="relative w-full md:w-2/3 h-1/2 md:h-full overflow-hidden order-1 md:order-2">
              <Image src={item.image} alt={`Slide ${index + 1}`} class="h-full w-full object-cover" />
            </div>

            <!-- Text Section - Bottom on mobile, Left third on desktop -->
            <div class="primary-bg flex w-full md:w-1/3 h-1/2 md:h-full items-center justify-center order-2 md:order-1">
              <div class="px-4 md:ml-20 w-full md:w-2/3 max-w-md text-left">
                <p class="text-xl md:text-2xl leading-tight text-white">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Navigation Buttons - Hidden on mobile -->
    <button id="prev-btn" class="absolute left-6 z-10 rounded-full bg-[#134368] p-3 shadow-lg transition-all hover:bg-white hidden md:block" style="top: calc(4.5rem + 30vh - 1.5rem);">
      <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button id="next-btn" class="absolute right-6 z-10 rounded-full bg-white/80 p-3 shadow-lg transition-all hover:bg-white hidden md:block" style="top: calc(4.5rem + 30vh - 1.5rem);">
      <svg class="h-6 w-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <!-- Indicators - Centered on parent container -->
    <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 space-x-4">
      {carouselItems.map((_, index) => (
        <button 
          class="carousel-indicator h-3 w-3 rounded-full border-1 border-white bg-transparent transition-all"
          data-slide={index}
        ></button>
      ))}
    </div>
  </div>

  <div id="section-2"class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="section-2-main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="flex w-full">
          <div class="pt-4 pl-4 text-left sm:pt-16 flex-1">
            <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
              >02.</span
            >
            <div class="w-full sm:w-5/8">
              <h2
                class="leading-none font-bold tracking-normal"
                style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
              >
              echipamente de ultimă generație, configurate pentru precizie și recuperare rapidă
              </h2>
            </div>
          </div>
          <div class="hidden md:flex md:w-[12.5vw] flex-col">
            <div class="border-custom aspect-square flex-1 border-b border-l border-r"></div>
            <div class="border-custom aspect-square flex-1 border-b border-l border-r"></div>
            <div class="border-custom aspect-square flex-1 border-b border-l border-r"></div>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden md:block md:w-[12.5%]"></div>
  </div>
</Layout>
<!-- <div id="lottie-container" class="h-[240px] w-[240px] cursor-pointer border">
      <LottieAnimation id="target-animation" src="target.json" autoplay={false} loop={false} />
    </div> -->

<script>
  document.addEventListener('astro:page-load', () => {
    // Carousel functionality
    const carouselTrack = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const nextBtn = document.getElementById('next-btn');
    const prevBtn = document.getElementById('prev-btn');
    const indicators = document.querySelectorAll('.carousel-indicator');
    
    let currentSlide = 0;
    const totalSlides = slides.length;

    function updateCarousel() {
      if (!carouselTrack) return;

      // Check if we're on desktop (md breakpoint and above)
      const isDesktop = window.matchMedia('(min-width: 768px)').matches;

      if (isDesktop) {
        // Desktop: use transform with CSS transition
        const translateX = -currentSlide * 100;
        // Clear any existing transform and ensure proper styling
        carouselTrack.style.transition = 'transform 500ms ease-in-out';
        carouselTrack.style.transform = `translateX(${translateX}%)`;
        // Reset scroll position to prevent conflicts
        carouselTrack.scrollLeft = 0;
      } else {
        // Mobile: use scroll - clear transform to prevent conflicts
        carouselTrack.style.transform = '';
        const slideWidth = carouselTrack.clientWidth;
        carouselTrack.scrollTo({
          left: currentSlide * slideWidth,
          behavior: 'smooth'
        });
      }

      // Update indicators
      indicators.forEach((indicator, index) => {
        if (index === currentSlide) {
          indicator.classList.add('peach-bg');
        } else {
          indicator.classList.remove('peach-bg');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }

    function goToSlide(slideIndex) {
      currentSlide = slideIndex;
      updateCarousel();
    }

    // Event listeners
    nextBtn?.addEventListener('click', nextSlide);
    prevBtn?.addEventListener('click', prevSlide);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => goToSlide(index));
    });

    // Initialize carousel
    updateCarousel();
  });
</script>
