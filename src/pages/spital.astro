---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital.png';
import ct from '../assets/spital/ct.jpg';
import ecograph from '../assets/spital/ecograph.jpeg';
import mri from '../assets/spital/mri.jpg';
import hospital1 from '../assets/spital/hospital1.png';
import device from '../assets/despre/device.png';
import LottieAnimationContainer from '../components/LottieAnimationContainer.astro';
import ArrowDown from '../assets/arrow-down.svg';
import ArrowRight from '../assets/arrow-right.svg';
import multiroom from '../assets/spital/multiroom.jpg';
import single from '../assets/spital/single.jpg';
import relax from '../assets/spital/relax.jpg';
import access from '../assets/spital/access.jpg';
import network from '../assets/spital/network.jpg';
import Carousel from '../components/Carousel.astro';
import confort from '../assets/spital/confort.png';
import TriangleBarsAnimation from '../components/TriangleBarsAnimation.astro';
import SquaresAnimation from '../components/SquaresAnimation.astro';
import HeartAnimation from '../components/HeartAnimation.astro';
import PolygonAnimation from '../components/PolygonAnimation.astro';

const carouselItems = [
  {
    image: hospital1,
    description:
      'Utilizăm cele mai moderne tehnici chirurgicale mini-invazive pentru tratamentul herniilor, garantând o recuperare rapidă și rezultate excelente.',
  },
  {
    image: device,
    description:
      'Pacientul beneficiază de evaluare, intervenție chirurgicală minim invazivă și monitorizare postoperatorie, toate în același loc.',
  },
  {
    image: spital,
    description:
      'Am creat un traseu medical complet, într-un spațiu modern, sigur și bine organizat.',
  },
];

const confortCarouselItems = [
  {
    image: multiroom,
    title: 'saloane moderne',
    description: 'baie proprie, pat electric, TV, Wi-Fi, sistem de apelare',
  },
  {
    image: single,
    title: 'camere private',
    description: 'disponibile la cerere',
  },
  {
    image: relax,
    title: 'zone de relaxare',
    description: 'sală de mese, bibliotecă, terasă exterioară',
  },
  {
    image: access,
    title: 'acces facil',
    description: 'lift propriu, parcare pentru pacienți și aparținători',
  },
  {
    image: network,
    title: 'rețea digitală internă',
    description: 'acces rapid la analize, imagistică, dosar medical și plan operator',
  },
];
---

<Layout title="Hernia Center - Spitalul">
  <div class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="block md:hidden">
          <div class="px-4">
            <h1 class="text-6xl leading-none font-bold tracking-tight">spitalul</h1>
          </div>
          <div class="sm:group w-full pt-8">
            <Image
              src={spital}
              alt="Spital"
              class="w-full origin-top-right object-cover transition-transform duration-500 ease-out will-change-transform sm:group-hover:scale-[1.5]"
            />
          </div>
        </div>

        <div class="relative hidden md:flex">
          <!-- Desktop: Show h1 in grid cell -->
          <div
            class="border-custom flex aspect-square w-[12.5vw] items-end border-b border-l px-0 py-0"
          >
            <h1 class="page-header leading-none font-bold tracking-tight">spitalul</h1>
          </div>
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
          <!-- Hospital image - spanning cells on desktop -->
          <div
            id="hospital-image"
            class="group absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%] overflow-visible"
          >
            <Image
              src={spital}
              alt="Spital"
              class="h-full w-full origin-top-right object-cover transition-transform duration-500 ease-out will-change-transform md:group-hover:scale-[1.5]"
            />
          </div>
        </div>

        <!-- Row 2 - Hidden on mobile -->
        <div class="hidden md:flex">
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
        </div>
        <div class="pt-4 pl-4 text-left sm:pt-[12.5vw]">
          <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
            >01.</span
          >
          <div class="w-full sm:w-3/5">
            <h2
              class="leading-none font-bold tracking-normal"
              style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
            >
              Hernia Center - tratament modern al herniilor, în cadrul Spitalului Medicover Cluj
            </h2>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden md:block md:w-[12.5%]"></div>
  </div>

  <Carousel class="mt-18" items={carouselItems} />

  <div id="section-2" class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="section-2-main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="flex w-full">
          <div class="flex-1 pt-4 pl-4 text-left sm:pt-16">
            <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
              >02.</span
            >
            <div class="w-full sm:w-5/8">
              <h2
                class="leading-none font-bold tracking-normal"
                style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
              >
                echipamente de ultimă generație, configurate pentru precizie și recuperare rapidă
              </h2>
            </div>
          </div>
          <div class="hidden flex-col md:flex md:w-[12.5vw]">
            <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
            <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
            <div class="border-custom aspect-square flex-1 border-r border-l"></div>
          </div>
        </div>
      </section>

      <section id="animations" class="max-w-full px-0">
        <div class="mt-10 block px-4 sm:hidden">
          <div class="grid grid-cols-2">
            {
              [
                {
                  title: 'sisteme video 4K',
                  details: 'pentru vizualizare de înaltă definiție',
                },
                {
                  title: 'instrumentar dedicat',
                  details: 'intervențiilor de finețe',
                },
                {
                  title: 'sisteme avansate',
                  details: 'de electrocauterizare și sigilare vasculară',
                },
                {
                  title: 'plase chirurgicale',
                  details: 'pentru vizualizare de înaltă definiție',
                },
                {
                  title: 'tehnologii atraumatice',
                  details: 'intervențiilor de finețe',
                },
              ].map(({ title, details }, index, items) => (
                <button
                  class={`hernia-button border-custom hernia-container flex aspect-square cursor-pointer flex-col justify-between border-t border-l ${
                    index === items.length - 1
                      ? 'border-r border-b'
                      : index % 2 === 1
                        ? 'border-r sm:border-r-0'
                        : ''
                  } `}
                  data-number={String(index + 1).padStart(2, '0')}
                  data-title={title}
                  data-description={details}
                >
                  <div class="flex justify-between">
                    <div class="hernia-title font-semibold">
                      {String(index + 1).padStart(2, '0')}
                    </div>
                    <ArrowDown />
                  </div>
                  <h3 class="hernia-text">{title}</h3>
                </button>
              ))
            }
            <button
              class="group flex aspect-square flex-col justify-end bg-(--color-primary) p-4 transition-colors hover:opacity-90 sm:aspect-auto"
              onclick="location.href='/interventii'"
            >
              <div
                class="flex flex-col items-end justify-end text-2xl/6 text-white sm:text-xl/6 lg:text-3xl/6"
              >
                <ArrowRight
                  class="mt-1 ml-4 scale-60 transition-all duration-300 ease-out group-hover:translate-x-3"
                />
                programează-te
              </div>
            </button>
            <div class="border-custom hidden aspect-square border-b border-l sm:block"></div>
            <div class="border-custom hidden aspect-square border-r border-b border-l sm:block">
            </div>
            <div class="hidden aspect-square sm:block"></div>
          </div>
          <div
            id="hernina-type-modal"
            class="border-custom hernia-container absolute hidden cursor-pointer border bg-(--color-primary) p-7"
          >
            <div class="flex justify-between">
              <div id="hernia-number" class="hernia-title"></div>
              <ArrowDown />
            </div>
            <h3 id="hernia-title" class="hernia-text"></h3>
            <h3 id="hernia-description" class="hernia-text"></h3>
          </div>
        </div>

        <div
          class="border-custom relative hidden h-[12.5vw] divide-x overflow-visible border-t border-r border-l md:flex"
        >
          <LottieAnimationContainer
            id="lottie-1"
            src="Animation1.json"
            index="01"
            title="sisteme video 4K"
            details="pentru vizualizare de înaltă definiție"
          />
          <LottieAnimationContainer
            id="lottie-2"
            src="Animation2.json"
            index="02"
            title="instrumentar dedicat"
            details="intervențiilor de finețe"
          />
          <LottieAnimationContainer
            id="lottie-3"
            src="Animation3.json"
            index="03"
            title="sisteme avansate"
            details="de electrocauterizare și sigilare vasculară"
          />
        </div>
        <div
          class="border-custom relative hidden h-[12.5vw] divide-x overflow-visible border-t border-r border-l md:flex"
        >
          <LottieAnimationContainer
            id="lottie-4"
            src="Animation4.json"
            index="04"
            title="plase chirurgicale"
            details="pentru vizualizare de înaltă definiție"
          />
          <LottieAnimationContainer
            id="lottie-5"
            src="Animation5.json"
            index="05"
            title="tehnologii atraumatice"
            details="intervențiilor de finețe"
          />
          <div
            class="primary-bg border-custom relative z-10 flex flex-1 items-center justify-center overflow-hidden border-b"
          >
            <h3 class="text-center text-4xl text-white">programeaza-te</h3>
          </div>
        </div>
      </section>

      <div class="flex max-w-full px-0">
        <div class="justify-left flex w-full items-center text-left md:w-[66.666%]">
          <h3 class="description w-3/4 p-4 sm:p-0">
            Spitalul beneficiază și de acces imediat la servicii de imagistică de înaltă
            performanță, esențiale pentru un diagnostic corect și o planificare chirurgicală sigură.
          </h3>
        </div>
        <div class="hidden md:flex md:w-[33.333%] md:flex-wrap">
          <div class="border-custom aspect-square w-1/2 border-r border-b border-l"></div>
          <div class="border-custom aspect-square w-1/2 border-r border-b"></div>
          <div class="border-custom aspect-square w-1/2 border-r border-b border-l"></div>
          <div class="border-custom aspect-square w-1/2 border-r border-b"></div>
        </div>
      </div>

      <div class="mx-0 flex flex-col sm:mx-[12.5wv] sm:flex-row">
        {
          [
            {
              imgSrc: ecograph,
              text: 'ecografie',
            },
            {
              imgSrc: ct,
              text: 'tomografie computerizată',
            },
            {
              imgSrc: mri,
              text: 'rezonanță magnetică',
            },
          ].map((item) => (
            <div class="relative aspect-square md:w-[25vw]">
              <Image src={item.imgSrc} alt={item.text} class="h-full w-full" />
              <div class="absolute top-0 right-0 bottom-0 left-0 bg-black opacity-15" />
              <h3 class="absolute bottom-6 left-5 text-5xl leading-[clamp(2rem,3vw,4rem)] text-white sm:bottom-[1.5vw] sm:left-[1.2vw] sm:text-[clamp(2.5rem,4vw,5.5rem)]">
                {item.text}
              </h3>
            </div>
          ))
        }
      </div>

      <section class="max-w-full px-0">
        <div class="flex w-full">
          <div class="flex-1 py-8 pl-4 text-left sm:pt-16">
            <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
              >03.</span
            >
            <div class="w-full sm:w-5/8">
              <h2
                class="leading-none font-bold tracking-normal"
                style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
              >
                confort modern și funcționalitate medicală într-un singur spațiu
              </h2>
            </div>
          </div>
          <div class="hidden flex-col md:flex md:w-[12.5vw]">
            <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
            <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
            <div class="border-custom aspect-square flex-1 border-r border-l"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
  <Carousel items={confortCarouselItems} />
  <div class="hidden flex-row px-(--one-eigth-width) sm:flex">
    <div class="border-custom aspect-square flex-1 border-t border-r border-b border-l"></div>
    <div class="border-custom aspect-square flex-1 border-t border-r border-b"></div>
    <div class="border-custom aspect-square flex-1 border-t border-r border-b"></div>
    <div class="border-custom aspect-square flex-1 border-t border-r border-b"></div>
    <div class="border-custom aspect-square flex-1 border-t border-r border-b"></div>
    <div class="border-custom aspect-square flex-1 border-t border-r border-b"></div>
  </div>
  <div class="flex flex-row sm:px-(--one-eigth-width)">
    <div
      class="flex items-center px-4 py-4 text-[clamp(2rem,3.5vw,4rem)] leading-10 font-bold sm:aspect-[4/1] sm:h-[12.5vw] sm:p-0 sm:pr-2"
    >
      supraveghere medicală permanentă și echipă completă disponibilă 24/7
    </div>
    <div class="hidden aspect-[2/1] h-[12.5vw] bg-[var(--color-border-custom)] sm:block"></div>
  </div>
  <div class="flex flex-row flex-wrap sm:px-(--one-eigth-width)">
    <Image src={confort} alt="Confort" class="aspect-square w-full sm:w-[37.5vw]" />
    <div
      class="border-custom flex w-full flex-col justify-end border p-[clamp(1rem,4vw,4rem)] pt-30 sm:aspect-square sm:w-[37.5vw] sm:pt-4"
    >
      <SquaresAnimation />
      <div class="mt-4 text-2xl leading-7 sm:text-xl md:text-2xl">
        Fiecare detaliu este gândit pentru a oferi pacienților o experiență cât mai plăcută, sigură
        și lipsită de stres.
      </div>
    </div>
    <Image src={confort} alt="Confort" class="aspect-square w-full sm:hidden" />
    <div
      class="border-custom flex w-full flex-col justify-end border p-[clamp(1rem,4vw,4rem)] pt-30 sm:aspect-square sm:w-[37.5vw] sm:pt-4"
    >
      <HeartAnimation />
      <div class="mt-4 text-2xl leading-7 sm:text-xl md:text-2xl">
        După intervenție, pacienții beneficiază de monitorizare continuă, într-un spațiu complet
        echipat și asistat medical.
      </div>
    </div>
    <Image src={confort} alt="Confort" class="aspect-square w-full sm:w-[37.5vw]" />
    <Image src={confort} alt="Confort" class="hidden aspect-square w-full sm:block sm:w-[37.5vw]" />
    <div
      class="border-custom flex w-full flex-col justify-end border p-[clamp(1rem,4vw,4rem)] pt-30 sm:aspect-square sm:w-[37.5vw] sm:pt-4"
    >
      <PolygonAnimation />
      <div class="mt-4 text-2xl leading-7 sm:text-xl md:text-2xl">
        Asistența este prezentă permanent pe secție, iar echipa chirurgicală și echipa de terapie
        intensivă se află fizic în spital, gata să intervină oricând este nevoie.
      </div>
    </div>
    <Image src={confort} alt="Confort" class="aspect-square w-full sm:hidden" />
    <div
      class="border-custom flex w-full flex-col justify-end border p-[clamp(1rem,4vw,4rem)] pt-30 sm:aspect-square sm:w-[37.5vw] sm:pt-4"
    >
      <TriangleBarsAnimation />
      <div class="mt-4 text-2xl leading-7 sm:text-xl md:text-2xl">
        Această prezență medicală constantă oferă pacienților siguranță, răspunsuri rapide și o
        recuperare lipsită de stres, într-un mediu controlat și profesionist.
      </div>
    </div>
    <Image src={confort} alt="Confort" class="hidden aspect-square w-[37.5vw] sm:block" />
  </div>
  <section class="max-w-full md:px-(--one-eigth-width)">
    <div class="flex w-full">
      <div class="flex-1 py-8 pl-4 text-left sm:pt-16">
        <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
          >04.</span
        >
        <div class="w-full sm:w-5/8">
          <h2
            class="leading-none font-bold tracking-normal"
            style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
          >
            de ce aleg pacienții Hernia Center?
          </h2>
        </div>
      </div>
      <div class="hidden flex-col md:flex md:w-[12.5vw]">
        <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
        <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-6">
      {
        [
          {
            title: 'acces',
            details: 'la cea mai avansată tehnologie pentru tratamentul herniilor',
          },
          {
            title: 'echipamente',
            details: 'dedicate exclusiv chirurgiei minim invazive',
          },
          {
            title: 'recuperare',
            details: 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx',
          },
          {
            title: 'eficiență',
            details: 'în fiecare etapă, într-un singur loc',
          },
          {
            title: 'comunicare',
            details: 'directă cu echipa medicală, pe tot parcursul procesului',
          },
        ].map(({ title, details }, index, items) => (
          <button
            class={`hernia-button border-custom hernia-container flex aspect-square cursor-pointer flex-col justify-between border-t border-l sm:border-b ${
              index === items.length - 1
                ? 'border-r border-b'
                : index % 2 === 1
                  ? 'border-r sm:border-r-0'
                  : ''
            } `}
            data-number={String(index + 1).padStart(2, '0')}
            data-title={title}
            data-description={details}
            data-modal-id="reasons-modal"
          >
            <div class="flex justify-between">
              <div class="hernia-title font-semibold">{String(index + 1).padStart(2, '0')}</div>
              <ArrowDown />
            </div>
            <h3 class="hernia-text">{title}</h3>
          </button>
        ))
      }
      <button
        class="group flex aspect-square flex-col justify-end bg-(--color-primary) p-4 transition-colors hover:opacity-90 sm:aspect-auto"
        onclick="location.href='/interventii'"
      >
        <div
          class="flex flex-col items-end justify-end text-2xl/6 text-white sm:text-xl/6 lg:text-3xl/6"
        >
          <ArrowRight
            class="mt-1 ml-4 scale-60 transition-all duration-300 ease-out group-hover:translate-x-3"
          />
          citeste mai mult
        </div>
      </button>
      <div
        id="reasons-modal"
        class="border-custom hernia-container absolute hidden cursor-pointer border bg-(--color-primary) p-7"
      >
        <div class="flex justify-between">
          <div id="hernia-number" class="hernia-title"></div>
          <ArrowDown />
        </div>
        <h3 id="hernia-title" class="hernia-text"></h3>
        <h3 id="hernia-description" class="hernia-text"></h3>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Animations
    const animationContainers = document.querySelectorAll('.animation-container');
    const animationsWrapper = document.querySelector('#animations > div');

    animationContainers.forEach((container, index) => {
      container.addEventListener('click', (e) => {
        const isExpanded = container.classList.contains('expanded');
        const lottieId = `lottie-${index + 1}`;

        if (isExpanded) {
          // Reset text colors and hide details when collapsing
          const indexText = container.querySelector('.index-text');
          const titleText = container.querySelector('.title-text');
          const detailsText = container.querySelector('.details-text');
          if (indexText) indexText.style.color = '';
          if (titleText) titleText.style.color = '';
          if (detailsText) {
            detailsText.style.color = '';
            detailsText.style.opacity = '0';
          }

          // Reset Lottie animation immediately
          const animation = astroLottie.getAnimation(lottieId);
          if (animation && animation.isLoaded) {
            animation.player.goToAndStop(0, true);
          }

          // Get current and target heights
          const currentHeight = container.offsetHeight;
          const targetHeight = animationsWrapper.offsetHeight;

          // Set current height explicitly first
          container.style.height = `${currentHeight}px`;

          // Force reflow
          container.offsetHeight;

          // Then animate collapse in next frame
          requestAnimationFrame(() => {
            container.classList.remove('primary-bg', 'overflow-visible');
            container.classList.add('overflow-hidden');
            container.style.height = `${targetHeight}px`;
          });

          // After collapse completes (700ms), clean up
          setTimeout(() => {
            container.classList.remove('expanded', 'z-20');
            container.style.height = '';
          }, 700);
        } else {
          // Collapse all others first
          document.querySelectorAll('.animation-container').forEach((c, i) => {
            // Skip the container being expanded
            if (c === container) return;

            if (c.classList.contains('expanded')) {
              const otherLottieId = `lottie-${i + 1}`;
              const otherAnimation = astroLottie.getAnimation(otherLottieId);
              if (otherAnimation && otherAnimation.isLoaded) {
                // Reset to first frame immediately
                otherAnimation.player.goToAndStop(0, true);
              }

              // Hide all text immediately during collapse
              const indexText = c.querySelector('.index-text');
              const titleText = c.querySelector('.title-text');
              const detailsText = c.querySelector('.details-text');
              if (indexText) indexText.style.opacity = '0';
              if (titleText) titleText.style.opacity = '0';
              if (detailsText) detailsText.style.opacity = '0';

              // Reset text colors and visibility after collapse animation completes
              setTimeout(() => {
                if (indexText) {
                  indexText.style.color = '';
                  indexText.style.opacity = '';
                }
                if (titleText) {
                  titleText.style.color = '';
                  titleText.style.opacity = '';
                }
                if (detailsText) {
                  detailsText.style.color = '';
                  // Keep details hidden - it starts with opacity-0 in the component
                }
              }, 700);
            }
            c.classList.remove('expanded', 'z-20', 'primary-bg', 'overflow-visible');
            c.classList.add('overflow-hidden');
            c.style.height = '';
          });

          // Get current width and height
          const currentWidth = container.offsetWidth;
          const currentHeight = container.offsetHeight;

          // Set current height first
          container.style.height = `${currentHeight}px`;

          // Force reflow
          container.offsetHeight;

          // Then animate to target height
          requestAnimationFrame(() => {
            container.style.height = `${currentWidth}px`;
            container.classList.remove('overflow-hidden');
            container.classList.add('expanded', 'z-20', 'primary-bg', 'overflow-visible');

            // Change text color to white when expanded and show details
            const indexText = container.querySelector('.index-text');
            const titleText = container.querySelector('.title-text');
            const detailsText = container.querySelector('.details-text');
            if (indexText) indexText.style.color = 'white';
            if (titleText) titleText.style.color = 'white';
            if (detailsText) {
              detailsText.style.color = 'white';
              detailsText.style.opacity = '1';
            }

            // Start Lottie animation
            const animation = astroLottie.getAnimation(lottieId);
            if (animation && animation.isLoaded) {
              animation.player.setDirection(1);
              animation.player.play();
            }
          });
        }
      });
    });
    // Track a detachable global click listener for modal close
    let detachModalClose: (() => void) | null = null;

    Array.from(document.getElementsByClassName('hernia-button')).forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement | null;
        if (!el) return;

        const modalId = el.getAttribute('data-modal-id') || 'hernina-type-modal';
        const modal = document.getElementById(modalId) as HTMLElement | null;
        if (!modal) return;

        // If a previous close listener exists, remove it before re-opening
        if (detachModalClose) {
          detachModalClose();
          detachModalClose = null;
        }
        if (modal.style.display === 'flex') {
          // Ignore the very click that opened (listener added after frame)
          // @ts-ignore
          document.removeEventListener('click', docHandler, true);
          // @ts-ignore
          modal.removeEventListener('click', modalHandler, true);
          detachModalClose = null;
          close();
          return;
        }

        // Extract data attributes
        const number = el.getAttribute('data-number') || '';
        const title = el.getAttribute('data-title') || '';
        const description = el.getAttribute('data-description') || '';

        // Populate modal content
        const numEl = modal.querySelector('#hernia-number');
        const titleEl = modal.querySelector('#hernia-title');
        const descEl = modal.querySelector('#hernia-description');
        if (numEl) numEl.textContent = number;
        if (titleEl) titleEl.textContent = title;
        if (descEl) descEl.textContent = description;

        // Compute geometry (anchor top-left of button; modal doubled in size)
        const rect = el.getBoundingClientRect();
        const targetWidth = rect.width * 2;
        const targetHeight = rect.height * 2;
        const left = rect.left + window.scrollX;
        const top = rect.top + window.scrollY;

        const shouldAnchorRight = left + targetWidth > window.innerWidth;

        // Apply positioning & size
        Object.assign(modal.style, {
          ...(shouldAnchorRight
            ? { right: window.innerWidth - (left + rect.width) + 'px', left: 'auto' }
            : { left: left + 'px' }),
          top: top + 'px',
          width: targetWidth + 'px',
          height: targetHeight + 'px',
          display: 'flex',
          flexDirection: 'column',
          justifyContent: 'space-between',
          color: 'white',
          zIndex: '60',
          transformOrigin: `top ${shouldAnchorRight ? 'right' : 'left'}`,
          position: 'absolute',
          transition: 'transform 0.4s cubic-bezier(.22,1,.36,1), opacity 0.2s ease',
        } as CSSStyleDeclaration);

        // Opening animation: start at original button scale (0.5 if doubling)
        const scaleX = rect.width / targetWidth;
        const scaleY = rect.height / targetHeight;
        modal.style.opacity = '0';
        modal.style.transform = `scale(${scaleX}, ${scaleY})`;

        // Force reflow then animate
        void modal.offsetWidth;
        requestAnimationFrame(() => {
          modal.style.opacity = '1';
          modal.style.transform = 'scale(1,1)';

          // After opening animation begins, register global click to close
          const close = () => {
            // Reverse animation
            modal.style.transform = `scale(${scaleX}, ${scaleY})`;
            modal.style.opacity = '0';
            const handleEnd = (ev: TransitionEvent) => {
              if (ev.propertyName === 'transform' || ev.propertyName === 'opacity') {
                modal.removeEventListener('transitionend', handleEnd);
                // Hide modal (kept in DOM for reuse)
                modal.style.display = 'none';
              }
            };
            modal.addEventListener('transitionend', handleEnd);
          };

          const docHandler = () => {
            // Ignore the very click that opened (listener added after frame)
            document.removeEventListener('click', docHandler, true);
            modal.removeEventListener('click', modalHandler, true);
            detachModalClose = null;
            close();
          };

          const modalHandler = () => {
            document.removeEventListener('click', docHandler, true);
            modal.removeEventListener('click', modalHandler, true);
            detachModalClose = null;
            close();
          };

          // Use capture so we intercept before other handlers; ensures single fire
          document.addEventListener('click', docHandler, true);
          modal.addEventListener('click', modalHandler, true);

          // Provide a detach function for subsequent opens
          detachModalClose = () => {
            document.removeEventListener('click', docHandler, true);
            modal.removeEventListener('click', modalHandler, true);
          };
        });
      });
    });
  });
</script>

