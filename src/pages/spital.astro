---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital.png';
import LottieAnimation from 'astro-integration-lottie/Lottie.astro';
---

<Layout title="Hernia Center - Spitalul">
  <div class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="block md:hidden">
          <div class="px-4 py-4">
            <h1 class="text-5xl leading-none font-bold tracking-tight">spitalul</h1>
          </div>
          <div class="w-full">
            <Image src={spital} alt="Spital" class="w-full object-cover" />
          </div>
        </div>

        <div class="relative hidden md:flex">
          <!-- Desktop: Show h1 in grid cell -->
          <div
            class="border-custom flex aspect-square flex-1 items-end border-b border-l px-0 py-0"
          >
            <h1
              class="leading-none font-bold tracking-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.5rem); transform: translateY(clamp(8px, 0.5vw, 12px));"
            >
              spitalul
            </h1>
          </div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
          <!-- Hospital image - spanning cells on desktop -->
          <div
            id="hospital-image"
            class="absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%] transition-all duration-300"
          >
            <Image src={spital} alt="Spital" class="h-full w-full object-cover" />
          </div>
        </div>

        <!-- Row 2 - Hidden on mobile -->
        <div class="hidden md:flex">
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
        </div>
        <div class="pt-16 text-left">
          <span class="text-heading-number text-6xl font-bold">01.</span>
          <div class="w-2/3">
            <h2
              class="leading-none font-bold tracking-normal"
              style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
            >
              Hernia Center - tratament modern al herniilor, în cadrul Spitalului Medicover Cluj
            </h2>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden md:block md:w-[12.5%]"></div>
  </div>
  <div id="carousel-1" class="flex min-h-[60vh] w-full bg-gray-100">
    <!-- Text Section - Left third -->
    <div class="flex w-1/3 items-center justify-center bg-white p-8">
      <div class="max-w-md text-center">
        <h3 class="mb-4 text-2xl font-bold text-gray-800">Tehnologie Avansată</h3>
        <p class="leading-relaxed text-gray-600">
          Utilizăm cele mai moderne tehnici chirurgicale mini-invazive pentru tratamentul herniilor,
          garantând o recuperare rapidă și rezultate excelente.
        </p>
      </div>
    </div>

    <!-- Image Section - Right two-thirds -->
    <div class="relative w-2/3 overflow-hidden pt-16">
      <Image src={spital} alt="Echipament medical modern" class="h-full w-full object-cover" />
    </div>
  </div>
</Layout>
<!-- <div id="lottie-container" class="h-[240px] w-[240px] cursor-pointer border">
      <LottieAnimation id="target-animation" src="target.json" autoplay={false} loop={false} />
    </div> -->

<script>
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('lottie-container');

    if (container) {
      container.addEventListener('mouseenter', () => {
        const animation = astroLottie.getAnimation('target-animation');
        if (animation && animation.isLoaded) {
          animation.player.setDirection(1);
          animation.player.play();
        }
      });

      container.addEventListener('mouseleave', () => {
        const animation = astroLottie.getAnimation('target-animation');
        if (animation && animation.isLoaded) {
          animation.player.setDirection(-1);
          animation.player.play();
        }
      });
    }
  });
</script>
