---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital.png';
import hospital1 from '../assets/spital/hospital1.png';
import device from '../assets/despre/device.png';
import LottieAnimation from 'astro-integration-lottie/Lottie.astro';
import DownArrow from '../assets/arrow-down.svg';

const carouselItems = [
  {
    image: hospital1,
    description:
      'Utilizăm cele mai moderne tehnici chirurgicale mini-invazive pentru tratamentul herniilor, garantând o recuperare rapidă și rezultate excelente.',
  },
  {
    image: device,
    description:
      'Pacientul beneficiază de evaluare, intervenție chirurgicală minim invazivă și monitorizare postoperatorie, toate în același loc.',
  },
  {
    image: spital,
    description:
      'Am creat un traseu medical complet, într-un spațiu modern, sigur și bine organizat.',
  },
];
---

<Layout title="Hernia Center - Spitalul">
  <div class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="block md:hidden">
          <div class="px-4">
            <h1 class="text-5xl leading-none font-bold tracking-tight">spitalul</h1>
          </div>
          <div class="w-full pt-8">
            <Image src={spital} alt="Spital" class="w-full object-cover" />
          </div>
        </div>

        <div class="relative hidden md:flex">
          <!-- Desktop: Show h1 in grid cell -->
          <div
            class="border-custom flex aspect-square w-[12.5vw] items-end border-b border-l px-0 py-0"
          >
            <h1
              class="leading-none font-bold tracking-tight"
              style="font-size: clamp(2.25rem, 5vw, 4.5rem); transform: translateY(clamp(8px, 0.5vw, 12px));"
            >
              spitalul
            </h1>
          </div>
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
          <!-- Hospital image - spanning cells on desktop -->
          <div
            id="hospital-image"
            class="absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%] transition-all duration-300"
          >
            <Image src={spital} alt="Spital" class="h-full w-full object-cover" />
          </div>
        </div>

        <!-- Row 2 - Hidden on mobile -->
        <div class="hidden md:flex">
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
          <div class="border-custom aspect-square w-[12.5vw] border-b border-l"></div>
        </div>
        <div class="pt-4 pl-4 text-left sm:pt-16">
          <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
            >01.</span
          >
          <div class="w-full sm:w-3/5">
            <h2
              class="leading-none font-bold tracking-normal"
              style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
            >
              Hernia Center - tratament modern al herniilor, în cadrul Spitalului Medicover Cluj
            </h2>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden md:block md:w-[12.5%]"></div>
  </div>

  <div id="carousel-1" class="relative w-full overflow-hidden pt-18">
    <!-- Carousel Container -->
    <div class="carousel-container relative overflow-hidden">
      <div
        class="carousel-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth transition-transform duration-500 ease-in-out md:snap-none md:overflow-visible"
      >
        {
          carouselItems.map((item, index) => (
            <div class="carousel-slide flex h-[60vh] w-full flex-shrink-0 snap-start flex-col md:flex-row">
              {/* <!-- Image Section - Top on mobile, Right two-thirds on desktop --> */}
              <div class="relative order-1 h-1/2 w-full overflow-hidden md:order-2 md:h-full md:w-2/3">
                <Image
                  src={item.image}
                  alt={`Slide ${index + 1}`}
                  class="h-full w-full object-cover"
                />
              </div>

              {/* <!-- Text Section - Bottom on mobile, Left third on desktop --> */}
              <div class="primary-bg order-2 flex h-1/2 w-full items-center justify-center md:order-1 md:h-full md:w-1/3">
                <div class="w-full max-w-md px-4 text-left md:ml-20 md:w-2/3">
                  <p class="text-xl leading-tight text-white md:text-2xl">{item.description}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Navigation Buttons - Hidden on mobile -->
    <button
      id="prev-btn"
      class="absolute left-6 z-10 hidden rounded-full bg-[#134368] p-3 shadow-lg transition-all hover:bg-white md:block"
      style="top: calc(4.5rem + 30vh - 1.5rem);"
    >
      <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
    </button>

    <button
      id="next-btn"
      class="absolute right-6 z-10 hidden rounded-full bg-white/80 p-3 shadow-lg transition-all hover:bg-white md:block"
      style="top: calc(4.5rem + 30vh - 1.5rem);"
    >
      <svg class="h-6 w-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </button>

    <!-- Indicators - Centered on parent container -->
    <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 space-x-4">
      {
        carouselItems.map((_, index) => (
          <button
            class="carousel-indicator h-3 w-3 rounded-full border-1 border-white bg-transparent transition-all"
            data-slide={index}
          />
        ))
      }
    </div>
  </div>

  <div id="section-2" class="flex w-full">
    <div class="hidden md:block md:w-[12.5%]"></div>

    <div id="section-2-main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="flex w-full">
          <div class="flex-1 pt-4 pl-4 text-left sm:pt-16">
            <span class="text-heading-number font-bold" style="font-size: clamp(2rem, 6vw, 4rem);"
              >02.</span
            >
            <div class="w-full sm:w-5/8">
              <h2
                class="leading-none font-bold tracking-normal"
                style="font-size: clamp(1.875rem, 4vw, 3.75rem);"
              >
                echipamente de ultimă generație, configurate pentru precizie și recuperare rapidă
              </h2>
            </div>
          </div>
          <div class="hidden flex-col md:flex md:w-[12.5vw]">
            <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
            <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
            <div class="border-custom aspect-square flex-1 border-r border-l"></div>
          </div>
        </div>
      </section>

      <section id="animations" class="max-w-full px-0">
        <div class="border-custom relative hidden h-[12.5vw] overflow-visible border-t md:flex">
          <div
            class="animation-container border-custom relative z-10 flex-1 overflow-hidden border-b border-l transition-all duration-700"
          >
            <DownArrow class="arrow-trigger absolute top-6 right-6 z-10 h-8 w-8 cursor-pointer" />
            <div class="absolute inset-0 h-full w-full">
              <LottieAnimation id="lottie-1" src="target.json" autoplay={false} loop={false} />
            </div>
          </div>
          <div
            class="animation-container border-custom relative z-10 flex-1 overflow-hidden border-b border-l transition-all duration-700"
          >
            <DownArrow class="arrow-trigger absolute top-6 right-6 z-10 h-8 w-8 cursor-pointer" />
            <div class="absolute inset-0 h-full w-full">
              <LottieAnimation id="lottie-2" src="target.json" autoplay={false} loop={false} />
            </div>
          </div>
          <div
            class="animation-container border-custom relative z-10 flex-1 overflow-hidden border-r border-b border-l transition-all duration-700"
          >
            <DownArrow class="arrow-trigger absolute top-6 right-6 z-10 h-8 w-8 cursor-pointer" />
            <div class="absolute inset-0 h-full w-full">
              <LottieAnimation id="lottie-3" src="target.json" autoplay={false} loop={false} />
            </div>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden md:block md:w-[12.5%]"></div>
  </div>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Carousel functionality
    const carouselTrack = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const nextBtn = document.getElementById('next-btn');
    const prevBtn = document.getElementById('prev-btn');
    const indicators = document.querySelectorAll('.carousel-indicator');

    let currentSlide = 0;
    const totalSlides = slides.length;

    function updateCarousel() {
      if (!carouselTrack) return;

      // Check if we're on desktop (md breakpoint and above)
      const isDesktop = window.matchMedia('(min-width: 768px)').matches;

      if (isDesktop) {
        // Desktop: use transform with CSS transition
        const translateX = -currentSlide * 100;
        // Clear any existing transform and ensure proper styling
        carouselTrack.style.transition = 'transform 500ms ease-in-out';
        carouselTrack.style.transform = `translateX(${translateX}%)`;
        // Reset scroll position to prevent conflicts
        carouselTrack.scrollLeft = 0;
      } else {
        // Mobile: use scroll - clear transform to prevent conflicts
        carouselTrack.style.transform = '';
        const slideWidth = carouselTrack.clientWidth;
        carouselTrack.scrollTo({
          left: currentSlide * slideWidth,
          behavior: 'smooth',
        });
      }

      // Update indicators
      indicators.forEach((indicator, index) => {
        if (index === currentSlide) {
          indicator.classList.add('peach-bg');
        } else {
          indicator.classList.remove('peach-bg');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }

    function goToSlide(slideIndex) {
      currentSlide = slideIndex;
      updateCarousel();
    }

    // Event listeners
    nextBtn?.addEventListener('click', nextSlide);
    prevBtn?.addEventListener('click', prevSlide);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => goToSlide(index));
    });

    // Add scroll event listener for mobile to sync currentSlide with actual scroll position
    let scrollTimeout;
    carouselTrack.addEventListener('scroll', () => {
      // Only handle scroll events on mobile
      const isDesktop = window.matchMedia('(min-width: 768px)').matches;
      if (isDesktop) return;

      // Debounce scroll events to avoid excessive updates
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const slideWidth = carouselTrack.clientWidth;
        const scrollLeft = carouselTrack.scrollLeft;
        const newSlide = Math.round(scrollLeft / slideWidth);

        // Update currentSlide only if it actually changed
        if (newSlide !== currentSlide && newSlide >= 0 && newSlide < totalSlides) {
          currentSlide = newSlide;
          // Update indicators without scrolling again
          indicators.forEach((indicator, index) => {
            if (index === currentSlide) {
              indicator.classList.add('peach-bg');
            } else {
              indicator.classList.remove('peach-bg');
            }
          });
        }
      }, 50);
    });

    // Initialize carousel
    updateCarousel();

    // Animation container expansion functionality
    const arrowTriggers = document.querySelectorAll('.arrow-trigger');
    const animationsWrapper = document.querySelector('#animations > div');

    arrowTriggers.forEach((arrow, index) => {
      arrow.addEventListener('click', (e) => {
        const container = e.currentTarget.closest('.animation-container');
        const isExpanded = container.classList.contains('expanded');
        const lottieId = `lottie-${index + 1}`;

        if (isExpanded) {
          // Reset Lottie animation immediately
          const animation = astroLottie.getAnimation(lottieId);
          if (animation && animation.isLoaded) {
            animation.player.goToAndStop(0, true);
          }

          // Get current and target heights
          const currentHeight = container.offsetHeight;
          const targetHeight = animationsWrapper.offsetHeight;

          // Set current height explicitly first
          container.style.height = `${currentHeight}px`;

          // Force reflow
          container.offsetHeight;

          // Then animate collapse in next frame
          requestAnimationFrame(() => {
            container.classList.remove('primary-bg', 'overflow-visible');
            container.classList.add('overflow-hidden');
            container.style.height = `${targetHeight}px`;
          });

          // After collapse completes (700ms), clean up
          setTimeout(() => {
            container.classList.remove('expanded', 'z-20');
            container.style.height = '';
          }, 700);
        } else {
          // Collapse all others first
          document.querySelectorAll('.animation-container').forEach((c, i) => {
            if (c.classList.contains('expanded')) {
              const otherLottieId = `lottie-${i + 1}`;
              const otherAnimation = astroLottie.getAnimation(otherLottieId);
              if (otherAnimation && otherAnimation.isLoaded) {
                // Reset to first frame immediately
                otherAnimation.player.goToAndStop(0, true);
              }
            }
            c.classList.remove('expanded', 'z-20', 'primary-bg', 'overflow-visible');
            c.classList.add('overflow-hidden');
            c.style.height = '';
          });

          // Get current width and height
          const currentWidth = container.offsetWidth;
          const currentHeight = container.offsetHeight;

          // Set current height first
          container.style.height = `${currentHeight}px`;

          // Force reflow
          container.offsetHeight;

          // Then animate to target height
          requestAnimationFrame(() => {
            container.style.height = `${currentWidth}px`;
            container.classList.remove('overflow-hidden');
            container.classList.add('expanded', 'z-20', 'primary-bg', 'overflow-visible');

            // Start Lottie animation
            const animation = astroLottie.getAnimation(lottieId);
            if (animation && animation.isLoaded) {
              animation.player.setDirection(1);
              animation.player.play();
            }
          });
        }
      });
    });
  });
</script>
