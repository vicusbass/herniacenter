        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="border-custom aspect-square sm:border-r sm:border-b sm:border-l"></div>
        <div class="border-custom aspect-square sm:border-r sm:border-b"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="border-custom aspect-square border-b sm:border-r sm:border-l"></div>
        <div class="border-custom aspect-square border-b sm:border-r"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="border-custom hidden aspect-square border-r border-b sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>

        <div class="border-custom block aspect-square border-r border-b border-l sm:hidden"></div>
        <div class="border-custom block aspect-square border-r border-b sm:hidden"></div>
        <div class="block aspect-square sm:hidden"></div>
        <div class="block aspect-square sm:hidden"></div>
        <div class="block aspect-square sm:hidden"></div>
        <div class="block aspect-square sm:hidden"></div>

        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
        <div class="hidden aspect-square sm:block"></div>
