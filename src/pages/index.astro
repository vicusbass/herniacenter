---
import { Image } from 'astro:assets';
import type { SanityDocument } from '@sanity/client';
import { loadQuery } from '../utils/loadQuery';
import { urlFor } from '../utils/sanityImageUrl';

import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../assets/whatsapp-icon.svg';
import ArrowDown from '../assets/arrow-down.svg';
import ArrowRight from '../assets/arrow-right.svg';
import PrimaryButton from '../components/PrimaryButton.astro';
import medic from '../assets/medic.png';
import TriangleBarsAnimation from '../components/TriangleBarsAnimation.astro';
import SquaresAnimation from '../components/SquaresAnimation.astro';
import HeartAnimation from '../components/HeartAnimation.astro';
import PolygonAnimation from '../components/PolygonAnimation.astro';

const { data: testimonials } = await loadQuery<SanityDocument[]>({
  query: `*[_type == "review"] | order(priority asc)[0...3] {
      _id,
      name,
      description,
      priority,
      image,
    }`,
});
const reviews = testimonials.map((review) => ({
  ...review,
  imageUrl: review?.image
    ? urlFor(review.image)?.auto('format').width(120).height(120).url()
    : null,
  name: review.name,
  description: review.description,
  rating: review?.rating || 5, // rating should be present
}));
