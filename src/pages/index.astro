<style>
  #scroll-title-wrapper {
    position: relative;
  }
  #scroll-title {
    transition: transform 0.1s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    #scroll-title {
      transition: none;
    }
  }
</style>

<script>
  import { ACTION_ERROR_CODES } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const title = document.getElementById('scroll-title');
    if (!title) return;

    let ticking = false;
    let maxShift = 0; // maximum horizontal translation (negative)
    let startOffset = 0; // vertical position where effect begins
    let effectHeight = 0; // scroll distance over which full shift occurs

    const computeMetrics = () => {
      const vw = window.innerWidth;
      const rect = title.getBoundingClientRect();
      const fullWidth = title.scrollWidth; // intrinsic width (nowrap)
      // Scroll begins when title enters viewport; we want whole width to traverse
      maxShift = Math.min(0, vw - fullWidth - 32); // extra 32px buffer
      startOffset = window.scrollY + rect.top - window.innerHeight * 0.6; // start a bit before center
      effectHeight = window.innerHeight * 1.5; // distance to complete animation
    };

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      if (y <= startOffset) {
        title.style.transform = 'translateX(0)';
        return;
      }
      const progress = Math.min(1.5, (2.3 * (y - startOffset)) / effectHeight);
      const shift = maxShift * progress;
      title.style.transform = `translateX(${shift}px)`;
    };

    const requestTick = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener('scroll', requestTick, { passive: true });
    window.addEventListener('resize', () => {
      computeMetrics();
      requestTick();
    });
    computeMetrics();
    update();

    // Track a detachable global click listener for modal close
    let detachModalClose: (() => void) | null = null;

    Array.from(document.getElementsByClassName('hernia-button')).forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const el = e.currentTarget as HTMLElement | null;
        if (!el) return;

        const modal = document.getElementById('hernina-type-modal') as HTMLElement | null;
        if (!modal) return;

        // If a previous close listener exists, remove it before re-opening
        if (detachModalClose) {
          detachModalClose();
          detachModalClose = null;
        }
        if (modal.style.display === 'flex') {
          // Ignore the very click that opened (listener added after frame)
          // @ts-ignore
          document.removeEventListener('click', docHandler, true);
          // @ts-ignore
          modal.removeEventListener('click', modalHandler, true);
          detachModalClose = null;
          close();
          return;
        }

        // Extract data attributes
        const number = el.getAttribute('data-number') || '';
        const title = el.getAttribute('data-title') || '';
        const description = el.getAttribute('data-description') || '';

        // Populate modal content
        const numEl = modal.querySelector('#hernia-number');
        const titleEl = modal.querySelector('#hernia-title');
        const descEl = modal.querySelector('#hernia-description');
        if (numEl) numEl.textContent = number;
        if (titleEl) titleEl.textContent = title;
        if (descEl) descEl.textContent = description;

        // Compute geometry (anchor top-left of button; modal doubled in size)
        const rect = el.getBoundingClientRect();
        const targetWidth = rect.width * 2;
        const targetHeight = rect.height * 2;
        const left = rect.left + window.scrollX;
        const top = rect.top + window.scrollY;

        const shouldAnchorRight = left + targetWidth > window.innerWidth;

        // Apply positioning & size
        Object.assign(modal.style, {
          ...(shouldAnchorRight
            ? { right: window.innerWidth - (left + rect.width) + 'px', left: 'auto' }
            : { left: left + 'px' }),
          top: top + 'px',
          width: targetWidth + 'px',
          height: targetHeight + 'px',
          display: 'flex',
          flexDirection: 'column',
          justifyContent: 'space-between',
          color: 'white',
          zIndex: '60',
          transformOrigin: `top ${shouldAnchorRight ? 'right' : 'left'}`,
          position: 'absolute',
          transition: 'transform 0.4s cubic-bezier(.22,1,.36,1), opacity 0.2s ease',
        } as CSSStyleDeclaration);

        // Opening animation: start at original button scale (0.5 if doubling)
        const scaleX = rect.width / targetWidth;
        const scaleY = rect.height / targetHeight;
        modal.style.opacity = '0';
        modal.style.transform = `scale(${scaleX}, ${scaleY})`;

        // Force reflow then animate
        void modal.offsetWidth;
        requestAnimationFrame(() => {
          modal.style.opacity = '1';
          modal.style.transform = 'scale(1,1)';

          // After opening animation begins, register global click to close
          const close = () => {
            // Reverse animation
            modal.style.transform = `scale(${scaleX}, ${scaleY})`;
            modal.style.opacity = '0';
            const handleEnd = (ev: TransitionEvent) => {
              if (ev.propertyName === 'transform' || ev.propertyName === 'opacity') {
                modal.removeEventListener('transitionend', handleEnd);
                // Hide modal (kept in DOM for reuse)
                modal.style.display = 'none';
              }
            };
            modal.addEventListener('transitionend', handleEnd);
          };

          const docHandler = () => {
            // Ignore the very click that opened (listener added after frame)
            document.removeEventListener('click', docHandler, true);
            modal.removeEventListener('click', modalHandler, true);
            detachModalClose = null;
            close();
          };

          const modalHandler = () => {
            document.removeEventListener('click', docHandler, true);
            modal.removeEventListener('click', modalHandler, true);
            detachModalClose = null;
            close();
          };

          // Use capture so we intercept before other handlers; ensures single fire
          document.addEventListener('click', docHandler, true);
          modal.addEventListener('click', modalHandler, true);

          // Provide a detach function for subsequent opens
          detachModalClose = () => {
            document.removeEventListener('click', docHandler, true);
            modal.removeEventListener('click', modalHandler, true);
          };
        });
      });
    });
  });
</script>
