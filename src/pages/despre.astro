---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital.png';
import hands from '../assets/despre/hands.png';
import morehands from '../assets/despre/morehands.png';

const baseAnimationClass =
  'gray-bg group-hover:bg-[#ffc1af] absolute top-1/2 left-1/2 h-9 w-9 -translate-x-1/2 -translate-y-1/2 transition-all duration-300 ease-out group-hover:h-4 group-hover:w-4';
---

<Layout title="Hernia Center - Despre">
  <!-- Mobile Layout -->
  <div class="w-full md:hidden">
    <h1 class="mb-4 pl-4 text-5xl leading-none font-bold tracking-tight">despre</h1>
    <Image src={spital} alt="Spital" class="h-auto w-full object-cover" />
  </div>

  <!-- Desktop Layout -->
  <div class="hidden w-full md:flex">
    <!-- Left empty column - 12.5% -->
    <div class="w-[12.5%]"></div>

    <!-- Main content column - 75% -->
    <div id="main-content" class="w-[75%]">
      <section class="max-w-full px-0">
        <!-- Row 1 -->
        <div class="relative flex">
          <div class="border-custom flex aspect-square flex-1 items-end border-b border-l">
            <h1
              class="translate-y-[3px] text-lg leading-none font-bold tracking-tight md:translate-y-[4px] md:text-4xl lg:translate-y-[6px] lg:text-5xl xl:translate-y-[8px] xl:text-6xl 2xl:translate-y-[8px] 2xl:text-7xl"
            >
              despre
            </h1>
          </div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
          <!-- Hospital image spanning from 3rd cell to end, covering 2 rows -->
          <div
            id="hospital-image"
            class="absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%] transition-all duration-300"
          >
            <Image src={spital} alt="Spital" class="h-full w-full object-cover" />
          </div>
        </div>

        <!-- Row 2 -->
        <div class="flex">
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
        </div>

        <!-- Row 3 -->
        <div class="flex">
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-r border-b border-l"></div>
        </div>

        <div class="flex">
          <div class="border-custom flex w-2/3 items-center">
            <h2
              class="text-left leading-tight font-bold tracking-tight"
              style="font-size: clamp(1.5rem, 4vw, 4rem);"
            >
              excelența în tratamentul herniilor,<br />
              de la diagnostic la recuperare
            </h2>
          </div>
          <div class="border-custom gray-bg aspect-square w-1/6"></div>
          <div class="border-custom gray-bg aspect-square w-1/6"></div>
        </div>

        <div class="flex">
          <div class="border-custom aspect-square w-1/2 border">
            <Image src={hands} alt="Hands" class="h-full w-full object-cover" />
          </div>
          <div class="border-custom relative aspect-square w-1/2 border-t border-r border-b">
            <!-- Animation container positioned in top left with border -->
            <div
              class="group border-custom absolute top-8 left-12 flex h-16 w-16 cursor-pointer items-center justify-center border"
            >
              <div
                class={` ${baseAnimationClass} group-hover:translate-x-1.5 group-hover:translate-y-1.5`}
              >
              </div>

              <div
                class={`${baseAnimationClass} group-hover:-translate-x-4.5 group-hover:translate-y-1.5`}
              >
              </div>

              <div
                class={`${baseAnimationClass} group-hover:translate-x-1.5 group-hover:-translate-y-4.5`}
              >
              </div>

              <div
                class={`${baseAnimationClass} group-hover:-translate-x-4.5 group-hover:-translate-y-4.5`}
              >
              </div>
            </div>

            <!-- Text positioned in bottom left -->
            <div class="absolute right-4 bottom-20 left-12">
              <p class="text-left text-3xl">
                La Hernia Center, ne concentrăm exclusiv pe diagnosticul și tratamentul herniilor
                abdominale, abordând fiecare caz cu profesionalism, precizie și grijă reală față de
                pacient.
              </p>
            </div>
          </div>
        </div>

        <div class="flex">
          <div class="border-custom relative aspect-square w-1/2 border-t border-r border-b">
            <!-- Animation container positioned in top left with border -->
            <div
              class="group border-custom absolute top-8 left-12 flex h-16 w-16 cursor-pointer items-center justify-center border"
            >
              <div class="group relative h-12 w-12 cursor-pointer">
                <!-- Circle -->
                <div
                  class="absolute inset-2 rounded-full bg-[#cedce5] transition-all duration-300 ease-out group-hover:scale-0 group-hover:opacity-0"
                >
                </div>

                <!-- Heart (wider with scale-x) -->
                <div
                  class="absolute inset-0 flex scale-0 items-center justify-center text-4xl text-[#cedce5] opacity-0 transition-all duration-300 ease-out group-hover:scale-100 group-hover:scale-x-125 group-hover:text-[#ffc1af] group-hover:opacity-100"
                >
                  ♥
                </div>
              </div>
            </div>

            <!-- Text positioned in bottom left -->
            <div class="absolute right-4 bottom-20 left-12">
              <p class="text-left text-3xl">
                Tratăm toate tipurile de hernii - de la cele frecvente, precum herniile inghinale și
                ombilicale, până la forme mai rare sau complexe - utilizând metode chirurgicale
                minim invazive care reduc semnificativ durerea postoperatorie și accelerează
                procesul de recuperare.
              </p>
            </div>
          </div>
          <div class="border-custom aspect-square w-1/2 border">
            <Image src={hands} alt="Hands" class="h-full w-full object-cover" />
          </div>
        </div>
      </section>

      <!-- Right empty column - 12.5% -->
      <div class="w-[12.5%]"></div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const hospitalImage = document.getElementById('hospital-image');

      if (hospitalImage) {
        hospitalImage.addEventListener('mouseenter', () => {
          hospitalImage.style.height = '300%';
          hospitalImage.style.width = '100%';
          hospitalImage.style.left = '0';
        });

        hospitalImage.addEventListener('mouseleave', () => {
          hospitalImage.style.height = '200%';
          hospitalImage.style.width = '66.667%';
          hospitalImage.style.left = '33.333%';
        });
      }
    });
  </script>
</Layout>
