---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital.png';
---

<Layout title="Hernia Center - Despre">
  <div class="flex w-full">
    <!-- Left empty column - 12.5% -->
    <div class="w-[12.5%]"></div>

    <!-- Main content column - 75% -->
    <div id="main-content" class="w-[75%]">
      <section class="max-w-full px-0">
        <!-- Row 1 -->
        <div class="relative flex">
          <div class="border-custom flex aspect-square flex-1 items-end border-b border-l">
            <h1
              class="translate-y-[3px] text-lg leading-none font-bold tracking-tight md:translate-y-[4px] md:text-4xl lg:translate-y-[6px] lg:text-5xl xl:translate-y-[8px] xl:text-6xl 2xl:translate-y-[8px] 2xl:text-7xl"
            >
              despre
            </h1>
          </div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
          <!-- Hospital image spanning from 3rd cell to end, covering 2 rows -->
          <Image
            src={spital}
            alt="Spital"
            class="absolute left-[33.333%] top-0 z-10 h-[200%] w-[66.667%] object-cover"
          />
        </div>

        <!-- Row 2 -->
        <div class="flex">
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
        </div>

        <!-- Row 3 -->
        <div class="flex">
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
        </div>
      </section>
    </div>

    <!-- Right empty column - 12.5% -->
    <div class="w-[12.5%]"></div>
  </div>
</Layout>
