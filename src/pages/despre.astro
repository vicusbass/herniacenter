---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import spital from '../assets/spital/spital_night.jpg';
import hands from '../assets/despre/hands.png';
import morehands from '../assets/despre/morehands.png';
import device from '../assets/despre/device.png';
import HeartAnimation from '../components/HeartAnimation.astro';
import SquaresAnimation from '../components/SquaresAnimation.astro';
import TriangleBarsAnimation from '../components/TriangleBarsAnimation.astro';
import PolygonAnimation from '../components/PolygonAnimation.astro';
---

<Layout title="Hernia Center - Despre">
  <!-- Responsive Layout -->
  <div class="flex w-full">
    <!-- Left empty column - hidden on mobile, 12.5% on desktop -->
    <div class="hidden md:block md:w-[12.5%]"></div>

    <!-- Main content column - full width on mobile, 75% on desktop -->
    <div id="main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <!-- Mobile: H1 and Image Stack -->
        <div class="block md:hidden">
          <div class="px-4 py-4">
            <h1 class="text-6xl leading-none font-bold tracking-tight">despre</h1>
          </div>
          <div class="w-full">
            <Image src={spital} alt="Spital" class="w-full object-cover" />
          </div>
        </div>

        <!-- Desktop: Grid Layout -->
        <div class="relative hidden md:flex">
          <!-- Desktop: Show h1 in grid cell -->
          <div
            class="border-custom flex aspect-square flex-1 items-end border-b border-l px-0 py-0"
          >
            <h1 class="page-header leading-none font-bold tracking-tight">despre</h1>
          </div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
          <!-- Hospital image - spanning cells on desktop -->
          <div
            id="hospital-image"
            class="absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%] transition-all duration-300"
          >
            <Image src={spital} alt="Spital" class="h-full w-full object-cover" />
          </div>
        </div>

        <!-- Row 2 - Hidden on mobile -->
        <div class="hidden md:flex">
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-b border-l"></div>
          <div class="border-custom aspect-square flex-1 border-r border-b border-l"></div>
        </div>

        <!-- Row 3 - Hidden on mobile -->
        <div class="hidden md:flex">
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-b border-l"></div>
          <div class="border-custom aspect-square w-1/6 border-r border-b border-l"></div>
        </div>

        <!-- Mobile: Text content -->
        <div class="block px-4 py-8 md:hidden">
          <h2 class="text-left text-3xl leading-tight font-bold tracking-tight">
            excelența în tratamentul herniilor, de la diagnostic la recuperare
          </h2>
        </div>

        <!-- Desktop: Text container -->
        <div class="hidden justify-start px-0 py-0 md:flex">
          <div class="border-custom flex w-2/3 items-center">
            <h2
              class="text-left text-[clamp(1.5rem,3.385vw,65px)] leading-[1.1] font-bold tracking-tight"
            >
              excelență în tratamentul herniilor,<br />
              de la diagnostic la recuperare
            </h2>
          </div>
          <div class="border-custom gray-bg aspect-square w-1/6"></div>
          <div class="border-custom gray-bg aspect-square w-1/6"></div>
        </div>

        <!-- Section 1 -->
        <div class="md:flex">
          <div class="aspect-square w-full md:w-1/2">
            <Image src={hands} alt="Hands" class="h-full w-full object-cover" />
          </div>

          <!-- Animation - Mobile only -->
          <div class="mobile-animate flex justify-start py-8 pl-4 md:hidden">
            <HeartAnimation />
          </div>

          <!-- Text - Mobile only -->
          <div class="px-4 pb-8 md:hidden">
            <p>
              La Hernia Center, ne concentrăm exclusiv pe diagnosticul și tratamentul herniilor
              abdominale, abordând fiecare caz cu profesionalism, precizie și grijă reală față de
              pacient.
            </p>
          </div>

          <!-- Animation + Text - Desktop only -->
          <div
            class="border-custom relative hidden aspect-square w-full border-t border-r md:block md:w-1/2"
          >
            <div class="absolute top-8 left-12">
              <HeartAnimation />
            </div>

            <div class="absolute right-4 bottom-20 left-12">
              <p class="text-clamp-36">
                La Hernia Center, ne concentrăm exclusiv pe diagnosticul și tratamentul herniilor
                abdominale, abordând fiecare caz cu profesionalism, precizie și grijă reală față de
                pacient.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 2: Mobile (image, animation, text) | Desktop (animation left, image right) -->
        <div class="md:flex">
          <!-- Image -->
          <div class="aspect-square w-full md:order-2 md:w-1/2">
            <Image src={morehands} alt="Hands" class="h-full w-full object-cover" />
          </div>

          <!-- Animation - Mobile only -->
          <div class="mobile-animate flex justify-start py-8 pl-4 md:hidden">
            <SquaresAnimation />
          </div>

          <!-- Text - Mobile only -->
          <div class="px-4 pb-8 md:hidden">
            <p>
              Tratăm toate tipurile de hernii – de la cele frecvente, precum herniile inghinale și
              ombilicale, până la forme mai rare sau complexe – utilizând metode chirurgicale minim
              invazive care reduc semnificativ durerea postoperatorie și accelerează procesul de
              recuperare.
            </p>
          </div>

          <!-- Animation + Text - Desktop only -->
          <div
            class="border-custom relative hidden aspect-square w-full border-l md:order-1 md:block md:w-1/2"
          >
            <div class="absolute top-8 left-12">
              <SquaresAnimation />
            </div>

            <div class="absolute right-4 bottom-20 left-12">
              <p class="text-clamp-36">
                Tratăm toate tipurile de hernii – de la cele frecvente, precum herniile inghinale și
                ombilicale, până la forme mai rare sau complexe – utilizând metode chirurgicale
                minim invazive care reduc semnificativ durerea postoperatorie și accelerează
                procesul de recuperare.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 3 -->
        <div class="md:flex">
          <div class="aspect-square w-full md:w-1/2">
            <Image src={device} alt="Device" class="h-full w-full object-cover" />
          </div>

          <!-- Animation - Mobile only -->
          <div class="mobile-animate flex justify-start py-8 pl-4 md:hidden">
            <TriangleBarsAnimation />
          </div>

          <!-- Text - Mobile only -->
          <div class="px-4 pb-8 md:hidden">
            <p>
              Folosim echipamente de ultimă generație și aplicăm tehnici moderne de chirurgie
              laparoscopică și robotică, pentru a oferi intervenții cât mai sigure, eficiente și cu
              un rezultat estetic superior.
            </p>
          </div>

          <!-- Animation + Text - Desktop only -->
          <div
            class="border-custom relative hidden aspect-square w-full border-r md:block md:w-1/2"
          >
            <div class="absolute top-8 left-12">
              <TriangleBarsAnimation />
            </div>

            <div class="absolute right-4 bottom-20 left-12">
              <p class="text-clamp-36">
                Folosim echipamente de ultimă generație și aplicăm tehnici moderne de chirurgie
                laparoscopică și robotică, pentru a oferi intervenții cât mai sigure, eficiente și
                cu un rezultat estetic superior.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 4 -->
        <div class="md:flex">
          <div class="aspect-square w-full md:order-2 md:w-1/2">
            <Image src={morehands} alt="Hands" class="h-full w-full object-cover" />
          </div>

          <!-- Animation - Mobile only -->
          <div class="mobile-animate flex justify-start py-8 pl-4 md:hidden">
            <PolygonAnimation />
          </div>

          <!-- Text - Mobile only -->
          <div class="px-4 pb-8 md:hidden">
            <p>
              Fiecare pacient beneficiază de un plan personalizat de tratament, adaptat nevoilor
              sale, într-un spațiu dedicat, modern și prietenos.
            </p>
          </div>

          <!-- Animation + Text - Desktop only -->
          <div
            class="border-custom relative hidden aspect-square w-full border-l md:order-1 md:block md:w-1/2"
          >
            <div class="absolute top-8 left-12">
              <PolygonAnimation />
            </div>

            <div class="absolute right-4 bottom-20 left-12">
              <p class="text-clamp-36">
                Fiecare pacient beneficiază de un plan personalizat de tratament, adaptat nevoilor
                sale, într-un spațiu dedicat, modern și prietenos.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 5 -->
      <div class="md:flex">
        <div class="aspect-square w-full md:w-1/2">
          <Image src={device} alt="Device" class="h-full w-full object-cover" />
        </div>

        <!-- Animation - Mobile only -->
        <div class="mobile-animate flex justify-start py-8 pl-4 md:hidden">
          <TriangleBarsAnimation />
        </div>

        <!-- Text - Mobile only -->
        <div class="px-4 pb-8 md:hidden">
          <p>
            Obiectivul nostru este simplu: o recuperare rapidă, fără durere, o experiență medicală
            pozitivă și o calitate a vieții cât mai bună după operația de hernie.
          </p>
        </div>

        <!-- Animation + Text - Desktop only -->
        <div
          class="border-custom relative hidden aspect-square w-full border-r border-b md:block md:w-1/2"
        >
          <div class="absolute top-8 left-12">
            <TriangleBarsAnimation />
          </div>

          <div class="absolute right-4 bottom-20 left-12">
            <p class="text-clamp-36">
              Obiectivul nostru este simplu: o recuperare rapidă, fără durere, o experiență medicală
              pozitivă și o calitate a vieții cât mai bună după operația de hernie.
            </p>
          </div>
        </div>
      </div>

      <!-- Right empty column - hidden on mobile, 12.5% on desktop -->
      <div class="hidden md:block md:w-[12.5%]"></div>
    </div>

    <style>
      p {
        font-size: clamp(1.5rem, 2.5vw, 1.625rem);
        line-height: 1.1;
        text-align: left;
      }

      @media (max-width: 1220px) {
        p {
          font-size: clamp(1.4rem, 2.2vw, 1.5rem);
        }
      }

      .text-clamp-36 {
        font-size: clamp(1.5rem, 1.875vw, 36px);
      }
    </style>

    <script>
      document.addEventListener('astro:page-load', () => {
        const hospitalImage = document.getElementById('hospital-image');

        // Only add hover events on desktop (md breakpoint and up)
        if (hospitalImage && window.innerWidth >= 768) {
          hospitalImage.addEventListener('mouseenter', () => {
            hospitalImage.style.height = '300%';
            hospitalImage.style.width = '100%';
            hospitalImage.style.left = '0';
          });

          hospitalImage.addEventListener('mouseleave', () => {
            hospitalImage.style.height = '200%';
            hospitalImage.style.width = '66.667%';
            hospitalImage.style.left = '33.333%';
          });
        }

        // Mobile animation observer - only on mobile devices
        if (window.innerWidth < 768) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in-view');
                }
              });
            },
            {
              threshold: 0.3,
              rootMargin: '-120px',
            }
          );

          // Observe all mobile animation containers
          const mobileAnimations = document.querySelectorAll('.mobile-animate');
          mobileAnimations.forEach((animation) => {
            observer.observe(animation);
          });
        }
      });
    </script>
  </div>
</Layout>
