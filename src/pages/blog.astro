---
import { Image } from 'astro:assets';
import type { SanityDocument } from '@sanity/client';
import { sanityClient } from 'sanity:client';
import Layout from '../layouts/Layout.astro';

import hospitalImage from '../assets/spital.png';
import PrimaryButton from '../components/PrimaryButton.astro';
import Separator from '../components/Separator.astro';
import WhatsAppIcon from '../assets/whatsapp-icon.svg';
import { urlFor } from '../utils/sanityImageUrl';
import contact from '../config/contact';

const PAGE = {
  title: 'blog',
  hero: {
    heading: 'Ce este o hernie abdominală și cum o recunoști?',
    copy: 'Află totul despre operația minim invazivă pentru hernia inghinală. Programează-te la Hernia Center pentru tratamente moderne și recuperare rapidă.',
  },
  cta: {
    text: 'programează-te',
  },
};
const POSTS_QUERY = `
*[_type == "post"] | order(publishedAt desc) {
  _id,
  title,
  description,
  slug,
  mainImage,
  publishedAt,
  body
}
`;

const posts = await sanityClient.fetch<SanityDocument[]>(POSTS_QUERY);
const articles = posts.map((post) => ({
  ...post,
  imageUrl: post?.mainImage
    ? urlFor(post.mainImage)?.auto('format').width(600).height(400).url()
    : null,
  publishedAt: new Date(post.publishedAt).toLocaleDateString('ro-RO', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }),
  title: post.title,
  description: post.description,
  slug: post.slug,
}));

const [featuredArticle, ...otherArticles] = articles;
---

<Layout title={`Hernia Center - Blog`}>
  <section>
    <div id="first-row" class="hidden md:flex">
      <div class="aspect-square w-[12.5%] flex-none"></div>
      <div
        class="border-custom flex aspect-square w-[12.5%] flex-none items-center justify-start border-r border-b border-l bg-white"
      >
        <h1 class="page-header font-bold tracking-tight">
          {PAGE.title}
        </h1>
      </div>
      <div class="border-custom aspect-square w-[12.5%] flex-none border-r border-b"></div>
      <div class="border-custom aspect-square w-[12.5%] flex-none border-r border-b"></div>
      <div class="border-custom aspect-square w-[12.5%] flex-none border-r border-b"></div>
      <div class="border-custom aspect-square w-[12.5%] flex-none border-r border-b"></div>
      <div class="border-custom aspect-square w-[12.5%] flex-none border-r border-b"></div>
      <div class="aspect-square w-[12.5%] flex-none"></div>
    </div>

    <!-- Desktop: full layout -->
    <div class="hidden md:flex">
      <div class="w-[12.5%] flex-none"></div>
      <div class="w-[50%] flex-none">
        {
          featuredArticle?.imageUrl ? (
            <img src={featuredArticle.imageUrl} alt={featuredArticle.title} class="h-auto w-full" />
          ) : (
            <Image src={hospitalImage} alt="Hernia Center" class="h-auto w-full" />
          )
        }
      </div>
      <div class="flex w-[25%] flex-col">
        <div class="flex-grow pt-4 pl-4">
          <h2 class="text-[clamp(1.2rem,2.5vw,2.8125rem)] leading-tight font-semibold">
            {featuredArticle?.title || PAGE.hero.heading}
          </h2>
          <p class="pt-2 text-[clamp(1rem,1.75vw,1.7rem)] lg:pt-3 xl:pt-4">
            {featuredArticle?.description || PAGE.hero.copy}
          </p>
          <a
            href={featuredArticle?.slug?.current
              ? `/blog/${featuredArticle.slug.current}`
              : '/blog'}
            class="inline-block pt-2 text-[clamp(1rem,1.75vw,1.7rem)] underline underline-offset-4 hover:text-blue-800"
          >
            citește mai mult
          </a>
        </div>
        <div class="pl-5">
          <PrimaryButton text={PAGE.cta.text} icon={WhatsAppIcon} href={contact.whatsapp} />
        </div>
      </div>
      <div class="w-[12.5%] flex-none"></div>
    </div>

    <Separator />

    <!-- Desktop: Blog Articles Grid -->
    <div class="mt-20 hidden md:block">
      <div class="flex">
        <div class="w-[12.5%]"></div>
        <div class="w-[75%]">
          <div class="grid grid-cols-3 gap-8">
            {
              otherArticles.map((article) => (
                <article class="overflow-hidden">
                  {/* Clean image without blur */}
                  <div class="h-64 overflow-hidden">
                    <div
                      class="h-full w-full bg-cover bg-center"
                      style={`background-image: url(${article.imageUrl || hospitalImage.src})`}
                    />
                  </div>
                  <div class="space-y-2 pt-4">
                    <h3 class="text-4xl leading-tight font-bold">{article.title}</h3>
                    <div class="text-2xl font-light text-gray-600">{article.publishedAt}</div>
                    <a
                      href={`/blog/${article.slug?.current}`}
                      class="inline-block text-2xl underline underline-offset-4 hover:text-blue-800"
                    >
                      citește mai mult
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
        <div class="w-[12.5%] bg-white"></div>
      </div>
    </div>

    <!-- Mobile: title + intro -->
    <div class="block md:hidden">
      <div class="px-4">
        <h1 class="text-6xl font-bold tracking-tight">{PAGE.title}</h1>
        <div class="mt-8">
          <h2 class="text-3xl leading-tight font-semibold">
            {featuredArticle?.title || PAGE.hero.heading}
          </h2>
        </div>
      </div>
      {
        featuredArticle?.imageUrl ? (
          <img
            src={featuredArticle.imageUrl}
            alt={featuredArticle.title}
            class="h-auto w-full pt-4"
          />
        ) : (
          <Image src={hospitalImage} alt="Hernia Center" class="h-auto w-full pt-4" />
        )
      }
      <div class="px-4">
        <p class="pt-5 text-lg leading-relaxed">
          {featuredArticle?.description || PAGE.hero.copy}
        </p>
        <a
          href={featuredArticle?.slug?.current ? `/blog/${featuredArticle.slug.current}` : '/blog'}
          class="inline-block pt-2 text-lg underline underline-offset-4"
        >
          citește mai mult
        </a>
        <div class="mt-8">
          <PrimaryButton text={PAGE.cta.text} icon={WhatsAppIcon} />
        </div>
      </div>

      <!-- Blog Articles -->
      <div class="mt-12 space-y-6">
        {
          otherArticles.map((article) => (
            <article class="relative overflow-hidden">
              <div class="relative h-80 overflow-hidden">
                <div
                  class="absolute inset-0 scale-110 bg-cover bg-center blur-xs"
                  style={`background-image: url(${article.imageUrl || hospitalImage.src})`}
                />
                {/* Dark overlay for better text contrast */}
                <div class="absolute inset-0 bg-black/30" />
                {/* Text content */}
                <div class="relative z-10 flex h-full flex-col justify-end p-6 text-white">
                  <div class="space-y-4">
                    <div class="text-2xl font-light">{article.publishedAt}</div>
                    <h3 class="text-4xl font-bold">{article.title}</h3>
                    <a
                      href={`/blog/${article.slug?.current}`}
                      class="hover:border-opacity-60 inline-block border-b border-white pb-1 text-2xl font-light underline-offset-4"
                    >
                      citește mai mult
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
