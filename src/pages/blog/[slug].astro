---
import type { SanityDocument } from '@sanity/client';
import { loadQuery } from '../../utils/loadQuery';
import { urlFor } from '../../utils/sanityImageUrl';
import Layout from '../../layouts/Layout.astro';
import { PortableText } from 'astro-portabletext';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const { data: posts } = await loadQuery<SanityDocument[]>({
    query: `*[_type == "post"]{
      _id,
      title,
      slug,
      mainImage,
      description,
      publishedAt,
      body
    }`,
  });

  return posts.map((post) => {
    const article = {
      imageUrl: post?.mainImage
        ? urlFor(post.mainImage)?.auto('format').width(1200).height(600).url()
        : null,
      publishedAt: new Date(post.publishedAt).toLocaleDateString('ro-RO', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
      }),
      title: post.title,
      body: post.body,
      slug: post.slug,
      description: post.description,
    };

    return {
      params: { slug: post.slug?.current || '' },
      props: { article },
    };
  });
}

const { article } = Astro.props;
---

<Layout title={`Hernia Center - ${article.title}`}>
  <main>
    <!-- Hero Image - Full width on mobile, constrained on desktop -->
    {
      article.imageUrl && (
        <div class="w-full md:flex md:justify-center">
          <Image
            src={article.imageUrl}
            alt={article.title}
            width={1200}
            height={600}
            class="w-full object-contain md:h-[36rem] md:w-3/4 md:object-cover"
          />
        </div>
      )
    }

    <!-- Content Container -->
    <div class="px-4 py-8 md:mx-auto md:max-w-4xl md:px-0 md:py-16">
      <!-- Title and Date -->
      <header class="mb-8">
        <h1 class="text-3xl leading-tight font-bold md:text-6xl">
          {article.title}
        </h1>
      </header>

      <!-- Article Content -->
      <article
        class="article-content prose prose-2xl prose-headings:font-bold prose-p:leading-tight prose-a:no-underline hover:prose-a:text-blue-800 prose-strong:font-semibold prose-blockquote:border-l-blue-500 prose-img:rounded-lg max-w-none"
      >
        {article.body && <PortableText value={article.body} />}
      </article>
    </div>
  </main>
</Layout>

<style>
  /* Reduce spacing between paragraphs */
  .article-content :global(p) {
    margin-top: 0;
    margin-bottom: 0;
  }

  /* Add more spacing before headings */
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  /* Remove spacing from empty paragraphs */
  .article-content :global(p:empty) {
    display: none;
  }

  /* Tighter spacing for bullet points (paragraphs starting with •) */
  .article-content :global(p) {
    line-height: 1.1;
  }

  /* Remove gaps between list items */
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-top: 0.5rem !important;
    margin-bottom: 0.5rem !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .article-content :global(li) {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    line-height: 1.1 !important;
  }

  .article-content :global(li > p) {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    line-height: 1.1 !important;
  }

  @media (min-width: 768px) {
    .article-content {
      font-size: 2rem;
      line-height: 1;
    }

    .article-content :global(h2) {
      font-size: 2.5rem;
      line-height: 1.1;
      margin-top: 3rem;
      margin-bottom: 1.5rem;
    }

    .article-content :global(h3) {
      font-size: 2rem;
      line-height: 1.1;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }

    .article-content :global(h4) {
      font-size: 2rem;
      line-height: 1.1;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    .article-content :global(p) {
      margin-top: 0;
      margin-bottom: 0;
    }
  }
</style>
