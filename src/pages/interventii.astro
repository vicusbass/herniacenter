---
import { Image } from 'astro:assets';
import type { SanityDocument } from '@sanity/client';
import { loadQuery } from '../utils/loadQuery';
import { toHTML } from '@portabletext/to-html';

import Layout from '../layouts/Layout.astro';
import WhatsAppIcon from '../assets/whatsapp-icon.svg';
import PrimaryButton from '../components/PrimaryButton.astro';
import contact from '../config/contact';
import ClockIcon from '../assets/interventii/clock.svg';
import NotesIcon from '../assets/interventii/notes.svg';
import PileIcon from '../assets/interventii/pile.svg';

// get hernia data ordered asc by "order" fields
const { data: hernii } = await loadQuery<SanityDocument[]>({
  query: `*[_type == "intervention"] | order(order asc) {
  name,
  id,
  order,
  duration,
  hospitalization,
  price,
  description
}`,
});
---

<Layout title="Hernia Center - Intervenții">
  <div class="mb-16 flex w-full">
    <div id="left-sidebar" class="hidden md:block md:w-[12.5%] md:flex-none"></div>

    <div id="main-content" class="w-full md:w-[75%]">
      <section class="max-w-full px-0">
        <div class="block md:hidden">
          <div class="px-4">
            <h1 class="text-6xl leading-none font-bold tracking-tight">intervenții</h1>
          </div>
          <div class="w-full pt-16">
            <p class="px-4 text-left text-2xl">
              Află totul despre operația minim invazivă pentru hernia inghinală. Programează-te la
              Hernia Center pentru tratamente moderne și recuperare rapidă.
            </p>
            <div class="px-4 pt-16">
              <div class="inline-block">
                <PrimaryButton text="programează-te" icon={WhatsAppIcon} href={contact.whatsapp} />
              </div>
            </div>
          </div>
        </div>

        <div class="relative hidden md:flex">
          <div
            class="border-custom flex aspect-square w-[16.666%] items-end border-b border-l px-0 py-0"
          >
            <h1 class="page-header leading-none font-bold tracking-tight">intervenții</h1>
          </div>
          <div class="border-custom aspect-square w-[16.666%] border-b border-l"></div>
          <div id="hospital-image" class="absolute top-0 left-[33.333%] z-10 h-[200%] w-[66.667%]">
            <div class="bg-contact flex h-full flex-col items-start justify-center px-[6vw]">
              <p class="text-left text-2xl">
                Află totul despre operația minim invazivă pentru hernia inghinală. Programează-te la
                Hernia Center pentru tratamente moderne și recuperare rapidă.
              </p>
              <div class="pt-[3vw]">
                <PrimaryButton text="programează-te" icon={WhatsAppIcon} href={contact.whatsapp} />
              </div>
            </div>
          </div>
        </div>

        <div class="hidden md:flex">
          <div class="border-custom aspect-square w-[16.666%] border-b border-l"></div>
          <div class="border-custom aspect-square w-[16.666%] border-b border-l"></div>
        </div>
        <!-- Desktop - hernia navigation squares -->
        <div class="hidden md:flex">
          {
            hernii.map((hernia, index) => (
              <a
                href={`#${hernia.id}`}
                class={`border-custom flex aspect-square w-[16.666%] cursor-pointer flex-col justify-between overflow-hidden border-b border-l text-left no-underline transition-colors duration-200 hover:bg-gray-50 ${index === hernii.length - 1 ? 'border-r' : ''}`}
                style="padding-left: clamp(10px, 1vw, 16px); padding-bottom: clamp(12px, 1.2vw, 20px); padding-top: clamp(20px, 2vw, 32px);"
                data-id={hernia.id}
                onclick={`event.preventDefault(); scrollToHernia('${hernia.id}');`}
              >
                <span
                  style="font-size: clamp(1.125rem, 2.08vw, 2.5rem);"
                  class="font-bold"
                >{`0${index + 1}.`}</span>
                <h3 style="font-size: clamp(1.125rem, 1.75vw, 2.25rem); line-height: 1.2;">
                  {hernia.name.split(' ')[0]}
                  <br />
                  {hernia.name.split(' ').slice(1).join(' ')}
                </h3>
              </a>
            ))
          }
        </div>

        <!-- Mobile dropdown -->
        <div class="block px-4 pt-8 md:hidden">
          <div class="relative" id="custom-dropdown">
            <button
              type="button"
              class="border-custom w-full cursor-pointer border bg-white p-3 pr-10 text-left text-2xl focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              id="dropdown-button"
              aria-expanded="false"
            >
              <span id="dropdown-text">Selectează tipul de hernie</span>
              <svg
                class="absolute top-1/2 right-3 h-4 w-4 -translate-y-1/2 transform fill-current text-gray-700 transition-transform duration-200"
                id="dropdown-arrow"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
              >
                <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"
                ></path>
              </svg>
            </button>

            <div
              class="absolute top-full right-0 left-0 z-10 mt-1 hidden rounded-lg border border-gray-300 bg-white shadow-lg"
              id="dropdown-menu"
            >
              {
                hernii.map((hernia, index) => (
                  <button
                    type="button"
                    class={`block w-full px-3 py-2 text-left text-2xl hover:bg-blue-50 ${index % 2 === 0 ? 'bg-gray-50' : 'bg-white'}`}
                    data-value={hernia.id}
                    onclick="selectOption(this)"
                  >
                    {hernia.name}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </section>
    </div>
    <div class="hidden flex-none md:block md:w-[12.5%]"></div>
  </div>
  {
    hernii.map((hernia, index) => (
      <>
        <div class={`flex w-full md:hidden`}>
          <div class="flex w-full flex-col">
            <div id={hernia.id} class="relative flex w-full flex-col px-4 py-12">
              <div class="text-heading-number mb-1 text-4xl font-bold">
                <span>0{hernia.order}.</span>
              </div>
              <h2 class="text-primary mb-6 text-4xl font-bold">{hernia.name}</h2>
              <div class="text-2xl leading-relaxed" set:html={toHTML(hernia.description)} />
            </div>
          </div>
        </div>

        {/* Mobile content */}
        <div class="bg-contact flex w-full md:hidden">
          <div class="flex w-full flex-col px-4 py-12">
            <div class="flex flex-col">
              <div class="border-custom flex w-full flex-row border border-b-0">
                <div class="flex w-1/2 flex-col items-start justify-start px-4 pt-4 pb-2">
                  <ClockIcon class="cell-icon" />
                  <div class="text-left text-2xl leading-tight">
                    Cât durează
                    <br />
                    operația?
                  </div>
                </div>
                <div class="border-custom flex w-1/2 items-end border-l">
                  <div class="px-4 pb-2 text-left text-4xl font-bold">{hernia.duration} min</div>
                </div>
              </div>

              <div class="border-custom flex w-full flex-row border border-b-0">
                <div class="flex w-1/2 flex-col items-start justify-start px-4 pt-4 pb-2">
                  <NotesIcon class="cell-icon" />
                  <div class="text-left text-2xl leading-tight">
                    Cât durează
                    <br />
                    spitalizarea?
                  </div>
                </div>
                <div class="border-custom flex w-1/2 items-end border-l">
                  <div class="px-4 pb-2 text-left text-4xl font-bold">
                    {hernia.hospitalization} zi
                  </div>
                </div>
              </div>

              <div class="border-custom flex w-full flex-row border">
                <div class="flex w-1/2 flex-col items-start justify-start px-4 pt-4 pb-2">
                  <PileIcon class="cell-icon" />
                  <div class="text-left text-2xl leading-tight">
                    Cât costă
                    <br />
                    intervenția?
                  </div>
                </div>
                <div class="border-custom relative flex w-1/2 items-end border-l">
                  <div class="absolute top-12 left-4 text-left text-xs">de la</div>
                  <div class="px-4 pb-2 text-left text-4xl font-bold">{hernia.price} €</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Desktop */}
        <div
          class={`hidden w-full md:flex ${index % 2 === 0 ? 'bg-contact' : ''}`}
          id={`desktop-${hernia.id}`}
        >
          <div class="hidden flex-none md:block md:w-[12.5%]" />

          <div class="flex w-full flex-col md:w-[75%] md:flex-row">
            <div class="relative flex w-[50%] flex-col pt-7 pb-12">
              <div class="desktop-hernia-title text-heading-number absolute -left-[4vw] mb-0">
                {hernia.order}.
              </div>
              <h2 class="text-primary desktop-hernia-title mb-6">
                <span>
                  {hernia.name.split(' ')[0]}
                  <br />
                  {hernia.name.split(' ').slice(1).join(' ')}
                </span>
              </h2>
              <div class="hernia-description pt-8 pr-16" set:html={toHTML(hernia.description)} />
            </div>

            <div class="flex w-[50%] flex-col py-12">
              <div class="flex min-h-[300px] flex-row">
                <div class="border-custom flex w-1/3 flex-col border border-r border-b">
                  <div class="flex w-full flex-[0_0_70%] flex-col items-start justify-start pt-4 pl-4">
                    <ClockIcon class="cell-icon-desktop" />
                    <div class="cell-label">
                      Cât durează
                      <br />
                      operația?
                    </div>
                  </div>
                  <div class="border-custom flex w-full flex-[0_0_30%] items-center border-t">
                    <div class="cell-value">{hernia.duration} min</div>
                  </div>
                </div>

                <div class="border-custom flex w-1/3 flex-col border border-r border-b border-l-0">
                  <div class="flex w-full flex-[0_0_70%] flex-col items-start justify-start pt-4 pl-4">
                    <NotesIcon class="cell-icon-desktop" />
                    <div class="cell-label">
                      Cât durează
                      <br />
                      spitalizarea?
                    </div>
                  </div>
                  <div class="border-custom flex w-full flex-[0_0_30%] items-center border-t">
                    <div class="cell-value">{hernia.hospitalization} zi</div>
                  </div>
                </div>

                <div class="border-custom flex w-1/3 flex-col border border-l-0">
                  <div class="flex w-full flex-[0_0_70%] flex-col items-start justify-start pt-4 pl-4">
                    <PileIcon class="cell-icon-desktop" />
                    <div class="cell-label">
                      Cât costă
                      <br />
                      intervenția?
                    </div>
                  </div>
                  <div class="border-custom relative flex w-full flex-[0_0_30%] items-center border-t">
                    <div class="absolute top-1 left-4 text-left text-base">de la</div>
                    <div class="cell-value">{hernia.price} €</div>
                  </div>
                </div>
              </div>

              <div class="mt-4 hidden pt-8 md:flex">
                <PrimaryButton text="programează-te" icon={WhatsAppIcon} href={contact.whatsapp} />
              </div>
            </div>
          </div>
          <div class="hidden flex-none md:block md:w-[12.5%]" />
        </div>
      </>
    ))
  }
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    function scrollToHernia(herniaId) {
      // Check if we're on desktop (md breakpoint is 768px)
      const isDesktop = window.innerWidth >= 768;
      const targetId = isDesktop ? `desktop-${herniaId}` : herniaId;
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }
    }

    // Make scrollToHernia globally available
    window.scrollToHernia = scrollToHernia;

    function selectOption(option) {
      const text = option.textContent;
      const value = option.dataset.value;

      document.getElementById('dropdown-text').textContent = text;
      document.getElementById('dropdown-menu').classList.add('hidden');
      document.getElementById('dropdown-arrow').classList.remove('rotate-180');
      document.getElementById('dropdown-button').setAttribute('aria-expanded', 'false');

      // Scroll to the corresponding hernia section
      const targetElement = document.getElementById(value);
      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }
    }

    // Make selectOption globally available
    window.selectOption = selectOption;

    const dropdownButton = document.getElementById('dropdown-button');
    if (dropdownButton) {
      dropdownButton.addEventListener('click', function () {
        const menu = document.getElementById('dropdown-menu');
        const arrow = document.getElementById('dropdown-arrow');
        const isOpen = !menu.classList.contains('hidden');

        if (isOpen) {
          menu.classList.add('hidden');
          arrow.classList.remove('rotate-180');
          this.setAttribute('aria-expanded', 'false');
        } else {
          menu.classList.remove('hidden');
          arrow.classList.add('rotate-180');
          this.setAttribute('aria-expanded', 'true');
        }
      });
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function (event) {
      const dropdown = document.getElementById('custom-dropdown');
      if (dropdown && !dropdown.contains(event.target)) {
        const menu = document.getElementById('dropdown-menu');
        const arrow = document.getElementById('dropdown-arrow');
        const button = document.getElementById('dropdown-button');

        if (menu) menu.classList.add('hidden');
        if (arrow) arrow.classList.remove('rotate-180');
        if (button) button.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .cell-icon {
    width: clamp(1.25rem, 2vw, 2rem);
    height: clamp(1.25rem, 2vw, 2rem);
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .cell-icon-desktop {
    width: clamp(1.75rem, 2.5vw, 2rem);
    height: clamp(1.75rem, 2.5vw, 2rem);
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .cell-label {
    font-size: clamp(1.25rem, 1.9vw, 1.8rem);
    text-align: left;
    line-height: 1.25;
    padding-top: clamp(0.5rem, 1vw, 1rem);
  }

  .cell-value {
    font-size: clamp(1.25rem, 2.5vw, 3.75rem);
    text-align: left;
    font-weight: bold;
    padding-left: 1rem;
    padding-right: 1rem;
    line-height: 1;
    transform: translateY(-0.05em);
  }

  .desktop-hernia-title {
    font-size: clamp(2rem, 1.5625rem + 2.2917vw, 4.375rem);
    font-weight: bold;
    line-height: 1;
  }

  .hernia-description {
    font-size: clamp(1.25rem, 2vw, 1.9rem);
    line-height: 1.6;
  }
</style>
