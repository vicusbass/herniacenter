---
import { Image } from 'astro:assets';
export interface Props {
  items: { title?: string; image: ImageMetadata; description: string }[];
  class?: string;
}
const { items, class: carouselClass = '' } = Astro.props;
// Using data attribute scoping instead of dynamic IDs for multi-instance safety
---

<div data-carousel-root class={`relative w-full overflow-hidden ${carouselClass}`}>
  <!-- Carousel Container -->
  <div class="carousel-container relative overflow-hidden">
    <div
      class="carousel-track flex snap-x snap-mandatory overflow-x-auto scroll-smooth transition-transform duration-500 ease-in-out md:snap-none md:overflow-visible"
    >
      {
        items.map((item, index) => (
          <div class="carousel-slide flex h-[60vh] w-full flex-shrink-0 snap-start flex-col md:flex-row">
            {/* <!-- Image Section - Top on mobile, Right two-thirds on desktop --> */}
            <div class="relative order-1 h-1/2 w-full overflow-hidden md:order-2 md:h-full md:w-2/3">
              <Image
                src={item.image}
                alt={`Slide ${index + 1}`}
                class="h-full w-full object-cover"
              />
            </div>

            {/* <!-- Text Section - Bottom on mobile, Left third on desktop --> */}
            <div class="primary-bg order-2 flex h-1/2 w-full items-center justify-center md:order-1 md:h-full md:w-1/3">
              <div class="w-full max-w-md px-4 text-left md:ml-20 md:w-2/3">
                {item.title && (
                  <p class="title mb-4 leading-10 font-bold text-white">{item.title}</p>
                )}
                <p class="description leading-tight text-white">{item.description}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Navigation Buttons - Hidden on mobile -->
  <button
    data-prev
    class="absolute left-6 z-10 hidden rounded-full bg-[#134368] p-3 shadow-lg transition-all hover:bg-white md:block"
    style="top: calc(4.5rem + 30vh - 1.5rem);"
    aria-label="Previous slide"
  >
    <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
      ></path>
    </svg>
  </button>

  <button
    data-next
    class="absolute right-6 z-10 hidden rounded-full bg-white/80 p-3 shadow-lg transition-all hover:bg-white md:block"
    style="top: calc(4.5rem + 30vh - 1.5rem);"
    aria-label="Next slide"
  >
    <svg class="h-6 w-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <!-- Indicators - Centered on parent container -->
  <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 space-x-4" data-indicators>
    {
      items.map((_, index) => (
        <button
          class="carousel-indicator h-3 w-3 rounded-full border-1 border-white bg-transparent transition-all"
          data-slide={index}
        />
      ))
    }
  </div>
</div>
<script>
  document.addEventListener('astro:page-load', () => {
    const roots = document.querySelectorAll('[data-carousel-root]');
    if (!roots.length) return;

    roots.forEach((rootEl) => {
      const carouselTrack = rootEl.querySelector('.carousel-track') as HTMLElement | null;
      const slides = rootEl.querySelectorAll('.carousel-slide');
      const nextBtn = rootEl.querySelector('[data-next]') as HTMLElement | null;
      const prevBtn = rootEl.querySelector('[data-prev]') as HTMLElement | null;
      const indicators = rootEl.querySelectorAll('.carousel-indicator');

      if (!carouselTrack || slides.length === 0) return;

      let currentSlide = 0;
      const totalSlides = slides.length;

      function updateCarousel() {
        if (!carouselTrack) return;
        const isDesktop = window.matchMedia('(min-width: 768px)').matches;
        if (isDesktop) {
          const translateX = -currentSlide * 100;
          carouselTrack.style.transition = 'transform 500ms ease-in-out';
          carouselTrack.style.transform = `translateX(${translateX}%)`;
          carouselTrack.scrollLeft = 0;
        } else {
          carouselTrack.style.transform = '';
          const slideWidth = carouselTrack.clientWidth;
          carouselTrack.scrollTo({ left: currentSlide * slideWidth, behavior: 'smooth' });
        }
        indicators.forEach((indicator, index) => {
          if (index === currentSlide) indicator.classList.add('peach-bg');
          else indicator.classList.remove('peach-bg');
        });
      }

      function nextSlide() {
        currentSlide = (currentSlide + 1) % totalSlides;
        updateCarousel();
      }
      function prevSlide() {
        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
        updateCarousel();
      }
      function goToSlide(slideIndex: number) {
        currentSlide = slideIndex;
        updateCarousel();
      }

      nextBtn && nextBtn.addEventListener('click', nextSlide);
      prevBtn && prevBtn.addEventListener('click', prevSlide);
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => goToSlide(index));
      });

      let scrollTimeout: number | undefined;
      carouselTrack.addEventListener('scroll', () => {
        const isDesktop = window.matchMedia('(min-width: 768px)').matches;
        if (isDesktop) return;
        clearTimeout(scrollTimeout);
        scrollTimeout = window.setTimeout(() => {
          const slideWidth = carouselTrack.clientWidth;
          const newSlide = Math.round(carouselTrack.scrollLeft / slideWidth);
          if (newSlide !== currentSlide && newSlide >= 0 && newSlide < totalSlides) {
            currentSlide = newSlide;
            indicators.forEach((indicator, index) => {
              if (index === currentSlide) indicator.classList.add('peach-bg');
              else indicator.classList.remove('peach-bg');
            });
          }
        }, 50);
      });

      updateCarousel();
    });
  });
</script>

<style>
  .description {
    font-size: clamp(1.25rem, 0.5rem + 1.3vw, 3rem);
  }
  .title {
    font-size: clamp(2rem, 1rem + 2.5vw, 5rem);
  }
</style>
