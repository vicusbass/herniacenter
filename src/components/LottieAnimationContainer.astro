---
import DownArrow from '../assets/arrow-down.svg';
import LottieAnimation from 'astro-integration-lottie/Lottie.astro';

interface Props {
  index: string;
  title: string;
  details: string;
  id: string;
  src: string;
  autoplay?: boolean;
  loop?: boolean;
}

const { index, title, details, id, src, autoplay = false, loop = false } = Astro.props;
---

<div
  class="animation-container border-custom relative z-10 flex-1 cursor-pointer overflow-hidden border-b transition-all duration-700"
>
  <span
    class="index-text absolute top-6 left-6 z-10 text-2xl font-bold transition-colors duration-700 xl:text-3xl 2xl:text-4xl"
    >{index}</span
  >
  <DownArrow class="arrow-trigger absolute top-6 right-6 z-10 h-7 w-7" />
  <h3
    class="title-text absolute left-6 z-10 text-2xl transition-colors duration-700 md:text-xl lg:text-2xl xl:text-3xl 2xl:text-4xl"
    style="top: calc(12.5vw - 1.5rem - 2.25rem);"
  >
    {title}
  </h3>
  <span
    class="details-text absolute bottom-6 left-6 z-10 w-3/4 text-left text-2xl opacity-0 transition-colors duration-700 md:text-xl md:leading-5 lg:text-2xl lg:leading-none xl:text-3xl 2xl:text-4xl"
    >{details}</span
  >
  <div class="absolute inset-0 h-full w-full">
    <LottieAnimation {id} {src} {autoplay} {loop} />
  </div>
</div>
