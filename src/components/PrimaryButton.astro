---
export interface Props {
  text: string;
  href?: string;
  icon?: any;
  class?: string;
  target?: string;
}

const { text, icon: Icon, class: className = '', href = '#', target = '_blank' } = Astro.props;
---

<a
  href={href}
  target={target}
  class={`primary-button rounded-4xl flex items-center bg-main-btn text-white transition-colors hover:opacity-90 ${className}`}
>
  {Icon && <Icon class="button-icon" />}
  <span class="mb-1">{text}</span>
</a>

<style>
  .primary-button {
    width: fit-content;
    min-width: clamp(12.5rem, 12.5vw, 15rem);
    height: 3rem;
    font-size: 1.5rem;
    padding: 0 clamp(1.5rem, 1.5vw, 2rem);
    white-space: nowrap;
  }

  .button-icon {
    width: 1.8rem;
    height: 1.8rem;
    margin-right: 0.75rem;
    flex-shrink: 0;
  }
</style>
