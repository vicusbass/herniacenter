---
import Logo from '../assets/logo.svg';
import Menu from '../assets/menu.svg';
import Close from '../assets/close.svg';

const menuItems = [
  { name: 'Spitalul', href: '/spital' },
  { name: 'Despre Dr. Trif', href: '/despre' },
  { name: 'Intervenții', href: '/interventii' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="border-custom bg-white md:border-b">
  <!-- Top navigation bar -->
  <nav class="relative max-w-full px-4 md:px-0">
    <div class="flex min-h-40 items-stretch">
      <div class="flex aspect-square w-[12.5%] flex-none items-center justify-center">
        <div class="flex h-12 w-12 items-center justify-center">
          <a href="/" class="block transition-transform duration-200 ease-in-out hover:opacity-90"
            ><Logo /></a
          >
        </div>
      </div>

      <!-- Desktop Navigation - Spans 6 columns with flex layout -->
      <div class="border-custom hidden w-full border-r border-l md:block" transition:persist>
        <div
          id="desktop-menu"
          class="menu-hidden hidden h-full flex-1 items-center justify-evenly space-x-4 md:flex md:space-x-8"
        >
          {
            menuItems.map((item) => (
              <a
                href={item.href}
                class="menu-link rounded-md px-4 py-2 font-medium text-gray-800 transition-colors duration-200 hover:bg-gray-100"
              >
                {item.name}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Empty spaces for mobile - spans 6 columns -->
      <div class="flex-1 md:hidden"></div>

      <!-- Hamburger menu button -->
      <div
        class="border-custom relative flex aspect-square w-[12.5%] flex-none items-center justify-center"
        transition:persist
      >
        <button
          id="mobile-menu-toggle"
          class="primary-bg relative flex min-h-[54px] min-w-[54px] cursor-pointer items-center justify-center hover:opacity-90"
          aria-label="Toggle menu"
        >
          <div class="icon-container">
            <div class="menu-icon">
              <Menu />
            </div>
            <div class="close-icon">
              <Close />
            </div>
          </div>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Full-screen Mobile Menu Modal -->
<div
  id="mobile-menu-modal"
  class="primary-bg fixed inset-0 z-50 hidden"
  aria-labelledby="menu-title"
  role="dialog"
  aria-modal="true"
>
  <div class="relative flex h-full w-full flex-col items-center justify-center">
    <!-- Menu Content -->
    <div id="menu-content">
      <nav class="flex flex-col items-center space-y-8">
        {
          menuItems.map((item) => (
            <a
              href={item.href}
              class="menu-item text-4xl font-medium text-white transition-colors duration-200 hover:text-gray-200"
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</div>

<style>
  .menu-link {
    font-size: clamp(1rem, 1.5vw, 2.1875rem);
    opacity: 0;
    transform: translateX(20px);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }

  .menu-link.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .menu-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
  }

  .menu-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Icon container styles */
  .icon-container {
    position: relative;
    width: 24px;
    height: 24px;
  }

  .menu-icon,
  .close-icon {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transition:
      opacity 0.3s ease-in-out,
      transform 0.3s ease-in-out;
  }

  /* Initial state: Menu icon visible, Close icon hidden */
  .menu-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .close-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.8);
  }

  /* Active state: Menu icon hidden, Close icon visible */
  .icon-container.active .menu-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
  }

  .icon-container.active .close-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* Desktop menu fade animation */
  #desktop-menu {
    transition: opacity 0.3s ease-in-out;
  }

  #desktop-menu.menu-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Mobile modal animation */
  #mobile-menu-modal {
    opacity: 0;
    transform: scale(0.1);
    /* dynamic transform-origin set via JS each open */
    transition:
      opacity 0.4s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  #mobile-menu-modal.active {
    opacity: 1;
    transform: scale(1);
  }

  /* Ensure toggle button always above modal */
  #mobile-menu-toggle {
    z-index: 60; /* higher than modal (z-50) */
  }
</style>

<script>
  function setupMenu() {
    const toggleButton = document.getElementById('mobile-menu-toggle');
    const modal = document.getElementById('mobile-menu-modal');
    const menuItems = document.querySelectorAll('.menu-item');
    const iconContainer = document.querySelector('.icon-container');
    const desktopMenu = document.getElementById('desktop-menu');

    const MENU_STATE_KEY = 'desktopMenuOpen';
    const MENU_INITIALIZED_KEY = 'desktopMenuInitialized';

    let isMenuOpen = false;

    // Function to check if we're on a small screen or larger
    const isLargeScreen = () => window.innerWidth >= 768;

    // Save menu state to sessionStorage
    const saveMenuState = (state: boolean) => {
      if (isLargeScreen()) {
        sessionStorage.setItem(MENU_STATE_KEY, state.toString());
      }
    };

    // Get menu state from sessionStorage
    const getMenuState = () => {
      const saved = sessionStorage.getItem(MENU_STATE_KEY);
      return saved === 'true';
    };

    // Check if this is the first load
    const isFirstLoad = () => {
      return !sessionStorage.getItem(MENU_INITIALIZED_KEY);
    };

    // Mark as initialized
    const markAsInitialized = () => {
      sessionStorage.setItem(MENU_INITIALIZED_KEY, 'true');
    };

    const computeTransformOrigin = () => {
      if (!toggleButton || !modal) return;
      const btnRect = toggleButton.getBoundingClientRect();
      const cx = btnRect.left + btnRect.width;
      const cy = btnRect.top;
      // viewport relative center converted to percentages
      const xPercent = (cx / window.innerWidth) * 100;
      const yPercent = (cy / window.innerHeight) * 100;
      modal.style.transformOrigin = `${xPercent}% ${yPercent}%`;
    };

    const openMobileMenu = () => {
      if (modal && iconContainer && !isLargeScreen()) {
        isMenuOpen = true;
        iconContainer.classList.add('active');
        computeTransformOrigin();
        // reveal first so transition can play
        modal.classList.remove('hidden');
        // force reflow to ensure transition starts
        void modal.offsetWidth;
        modal.classList.add('active');
        menuItems.forEach((item, index) => {
          setTimeout(() => item.classList.add('visible'), (index + 1) * 50);
        });
      }
    };

    const closeMobileMenu = () => {
      if (modal && iconContainer && !isLargeScreen()) {
        isMenuOpen = false;
        iconContainer.classList.remove('active');
        modal.classList.remove('active');
        menuItems.forEach((item) => item.classList.remove('visible'));
        // after transition hide completely
        // @ts-ignore - runtime JS only, event typing not required
        const handleTransitionEnd = (e) => {
          if (e.target === modal && e.propertyName === 'opacity') {
            modal.classList.add('hidden');
            modal.removeEventListener('transitionend', handleTransitionEnd);
          }
        };
        modal.addEventListener('transitionend', handleTransitionEnd);
      }
    };

    const toggleDesktopMenu = (skipSave = false) => {
      if (desktopMenu && iconContainer && isLargeScreen()) {
        const desktopMenuLinks = desktopMenu.querySelectorAll('.menu-link');

        if (isMenuOpen) {
          isMenuOpen = false;
          iconContainer.classList.remove('active');
          desktopMenuLinks.forEach((link) => link.classList.remove('visible'));
          desktopMenu.classList.add('menu-hidden');
          if (!skipSave) saveMenuState(false);
        } else {
          isMenuOpen = true;
          iconContainer.classList.add('active');
          desktopMenu.classList.remove('menu-hidden');
          // Stagger the animation of menu links
          desktopMenuLinks.forEach((link, index) => {
            setTimeout(() => link.classList.add('visible'), index * 100);
          });
          if (!skipSave) saveMenuState(true);
        }
      }
    };

    const toggleMenu = () => {
      if (isLargeScreen()) {
        toggleDesktopMenu();
      } else {
        if (isMenuOpen) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      }
    };

    // Reset menu state on window resize
    const handleResize = () => {
      if (isLargeScreen()) {
        // On large screens, hide mobile modal and reset mobile state
        if (modal) {
          modal.classList.add('hidden');
        }
        menuItems.forEach((item) => {
          item.classList.remove('visible');
        });
        // Restore desktop menu state from sessionStorage
        const savedState = getMenuState();
        if (desktopMenu) {
          if (savedState) {
            isMenuOpen = true;
            iconContainer?.classList.add('active');
            desktopMenu.classList.remove('menu-hidden');
          } else {
            isMenuOpen = false;
            iconContainer?.classList.remove('active');
            desktopMenu.classList.add('menu-hidden');
          }
        }
      } else {
        // On small screens, ensure desktop menu is visible and reset desktop state
        if (desktopMenu) {
          desktopMenu.classList.remove('menu-hidden');
        }
        // Reset mobile state if needed
        if (isMenuOpen && modal) {
          modal.classList.add('hidden');
        }
        // Reset icon and menu state for mobile
        if (iconContainer) {
          iconContainer.classList.remove('active');
        }
        isMenuOpen = false;
      }

      // recompute origin if menu is about to be opened again
      computeTransformOrigin();
    };

    if (toggleButton) toggleButton.addEventListener('click', toggleMenu);

    // Listen for window resize to handle responsive behavior
    window.addEventListener('resize', handleResize);

    // Initial setup
    if (isLargeScreen()) {
      // Check if this is the first load in the session
      if (isFirstLoad()) {
        // First load: open menu with animation after delay
        markAsInitialized();
        setTimeout(() => {
          toggleDesktopMenu();
        }, 500);
      } else {
        // Subsequent loads: restore state immediately
        const savedState = getMenuState();
        const desktopMenuLinks = desktopMenu?.querySelectorAll('.menu-link');

        if (savedState) {
          isMenuOpen = true;
          if (iconContainer) iconContainer.classList.add('active');
          if (desktopMenu) desktopMenu.classList.remove('menu-hidden');
          // Show links immediately without animation on subsequent loads
          desktopMenuLinks?.forEach((link) => link.classList.add('visible'));
        } else {
          isMenuOpen = false;
          if (iconContainer) iconContainer.classList.remove('active');
          if (desktopMenu) desktopMenu.classList.add('menu-hidden');
          desktopMenuLinks?.forEach((link) => link.classList.remove('visible'));
        }
      }
    } else {
      handleResize();
    }
  }

  document.addEventListener('astro:page-load', setupMenu);
</script>
