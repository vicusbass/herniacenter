---
import AnimationContainer from './AnimationContainer.astro';

const baseAnimationClass =
  'gray-bg group-hover:bg-[#ffc1af] absolute top-1/2 left-1/2 h-9 w-9 -translate-x-1/2 -translate-y-1/2 transition-all duration-300 ease-out group-hover:h-4 group-hover:w-4';
---

<AnimationContainer>
  <div class={` ${baseAnimationClass} group-hover:translate-x-1.5 group-hover:translate-y-1.5`}>
  </div>

  <div class={`${baseAnimationClass} group-hover:-translate-x-4.5 group-hover:translate-y-1.5`}>
  </div>

  <div class={`${baseAnimationClass} group-hover:translate-x-1.5 group-hover:-translate-y-4.5`}>
  </div>

  <div class={`${baseAnimationClass} group-hover:-translate-x-4.5 group-hover:-translate-y-4.5`}>
  </div>
</AnimationContainer>
